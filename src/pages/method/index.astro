---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Icon from '../../components/Icon.astro';
import CycleSteps from '../../components/CycleSteps.astro';
import CTA from '../../components/CTA.astro';
import { pageSeo } from '../../data/keywords';
const seo = pageSeo('/method/');

const crumbs = [{ label: 'متد کودک ماهر' }];
const cycleItems = [
  { title: 'پیش‌بینی', text: 'قبل از کار، کودک حدس می‌زند. «فکر می‌کنم این کار چقدر طول بکشد؟ از آن خوشم می‌آید؟ کجایش برایم سخت است؟»' },
  { title: 'تجربه', text: 'کار واقعی انجام می‌دهد؛ در کارگاه، در کلاس، در یک مسئولیت واقعی در مدرسه یا در گفت‌وگو با یک فرد شاغل.' },
  { title: 'بازبینی', text: 'حدسش را با نتیجه مقایسه می‌کند. فاصله بین حدس و واقعیت شکست نیست؛ ماده خام شناخت خود است.' },
];
const pillars = [
  { t: 'دانش', d: 'شناخت خود، رشته‌ها، شغل‌ها و دنیای پیرامون' },
  { t: 'مهارت', d: 'توانایی انجام کار: تصمیم‌گیری، حل مسئله، همکاری، ساختن' },
  { t: 'نگرش', d: 'نگاه و انگیزه کودک به یادگیری، به خود و به دیگران' },
  { t: 'ارزش و منش', d: 'ارزش‌هایی که کودک به آن باور دارد و رفتاری که از آن در او پایدار می‌شود' },
];
const principles = [
  { t: 'مسئله واقعی، واحد اصلی یادگیری است.', d: 'به‌جای تمرین‌های فرضی، بچه‌ها روی کارهای واقعی کار می‌کنند.' },
  { t: 'مسئولیت تدریجی.', d: 'هر سال کمی بیشتر از کارهای واقعی به خود دانش‌آموز سپرده می‌شود.' },
  { t: 'معلم همراه است، نه فقط مدرس.', d: 'معلم بیشتر می‌پرسد تا جواب بدهد.' },
  { t: 'بی‌نمره و بی‌مقایسه.', d: 'فرم‌های مشاهده رفتار را ثبت می‌کنند، نه صفت. بچه‌ها با هم مقایسه نمی‌شوند.' },
  { t: 'بدون برچسب استعداد.', d: 'علاقه به یک کارگاه، دلیل کافی برای گفتن «استعدادش این است» نیست.' },
];
---
<Base title={seo.title} description={seo.description} crumbs={crumbs}>
  <PageHero title="متد کودک ماهر: پیش‌بینی، تجربه، بازبینی" subtitle="روشی برای اینکه کودک خودش را با شاهد بشناسد، نه با حدس دیگران." kicker="متد" crumbs={crumbs} />

  <Section id="goal" kicker="هدف" title="دو نقطه انتخاب آگاهانه">
    <div class="mt-10 grid gap-5 md:grid-cols-2" data-stagger>
      <div class="card flex gap-6 p-7"><span class="num text-[3.5rem] leading-none text-accent">۱۵</span><div><h3 class="text-xl">۱۵ سالگی (پایه نهم)</h3><p class="mt-1 text-ink-soft">اولین انتخاب رشته تحصیلی.</p></div></div>
      <div class="card flex gap-6 p-7"><span class="num text-[3.5rem] leading-none text-accent">۱۸</span><div><h3 class="text-xl">۱۸ سالگی</h3><p class="mt-1 text-ink-soft">بازنگری و انتخاب نهایی برای دانشگاه یا ورود به کار.</p></div></div>
    </div>
    <div class="mt-10 max-w-3xl space-y-4" data-reveal>
      <p class="lead">بین ۱۵ تا ۱۸ سالگی، نوجوان خودش، شخصیتش و دنیای کار آینده را دوباره واکاوی می‌کند تا انتخاب دوم بر پایه شناخت بیشتری باشد.</p>
      <p class="lead">«انتخاب آگاهانه» برای ما یعنی دانش‌آموز بتواند بگوید چه گزینه‌هایی را واقعاً امتحان کرده، چه چیزی درباره خودش فهمیده و چرا این مسیر را انتخاب کرده است. معیار اصلی ما این است که انتخاب برای خود دانش‌آموز معنا داشته باشد؛ بعد برای خانواده و جامعه.</p>
    </div>
  </Section>

  <Section id="cycle" kicker="هسته متد" title="یک چرخه ساده" tone="white">
    <div class="mt-12"><CycleSteps items={cycleItems} /></div>
    <blockquote class="mt-10 max-w-3xl border-r-2 border-accent pr-6" data-reveal>
      <p class="font-serif text-[1.1875rem] leading-[2]">انتخاب رشته هم در اصل یک پیش‌بینی درباره خود است: «فکر می‌کنم در این رشته موفق و راضی خواهم بود.» کودکی که سال‌ها حدس زدن و سنجیدن حدسش را تمرین کرده، در ۱۵ سالگی این پیش‌بینی بزرگ را دقیق‌تر انجام می‌دهد.</p>
      <p class="mt-3 font-medium">این فرضیه اصلی ماست و با پرونده رشد بچه‌ها آن را می‌سنجیم.</p>
    </blockquote>
  </Section>

  <Section id="pillars" kicker="ارکان" title="چهار رکن رشد">
    <ul class="mt-12 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
      {pillars.map((p) => <li class="border-t-2 border-ink py-5"><h3 class="text-xl">{p.t}</h3><p class="mt-2 text-ink-soft">{p.d}</p></li>)}
    </ul>
    <p class="lead mt-8 max-w-3xl" data-reveal>وقتی این چهار با هم در حل یک مسئله واقعی به کار می‌روند، «شایستگی» ساخته می‌شود. منش کودک را نمره نمی‌دهیم؛ فقط با مشاهده طولانی و گفت‌وگو آن را دنبال می‌کنیم.</p>
  </Section>

  <Section id="principles" kicker="اجرا" title="اصول اجرا" tone="sand">
    <ul class="mt-10 border-t border-line-strong" data-stagger>
      {principles.map((p) => (
        <li class="grid gap-1 border-b border-line-strong py-5 sm:grid-cols-[18rem_1fr] sm:gap-8">
          <p class="font-medium">{p.t}</p><p class="text-ink-soft">{p.d}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="roots" kicker="پشتوانه" title="ریشه‌ها و آنچه سهم ماست">
    <div class="mt-10 grid gap-10 lg:grid-cols-2" data-stagger>
      <p class="lead">ایده پیش‌بینی، تجربه و بازبینی در آموزش سابقه دارد؛ مثلاً در الگوی «برنامه‌ریزی، انجام، مرور» در آموزش پیش‌دبستانی، الگوی «پیش‌بینی، مشاهده، توضیح» در آموزش علوم، و چرخه یادگیری تجربی کولب. ما از این پشتوانه استفاده می‌کنیم.</p>
      <p class="text-[1.0625rem] leading-[1.9] sm:text-lg">آنچه کودک ماهر به آن اضافه می‌کند این است که این چرخه را به ستون فقرات پیوسته‌ای از ۳ تا ۱۸ سالگی تبدیل کرده، آن را به هدف مشخص انتخاب آگاهانه در ۱۵ و ۱۸ سالگی گره زده، و «خطای پیش‌بینی درباره خود» را سال‌به‌سال در پرونده رشد هر کودک ثبت می‌کند.</p>
    </div>
  </Section>

  <Section id="status" kicker="وضعیت" title="وضعیت فعلی متد" tone="white">
    <p class="lead mt-6 max-w-3xl" data-reveal>متد کودک ماهر در حال اجرای آزمایشی و بهبود است. اجرای منظم آن در همه مقطع‌ها از <strong class="text-ink">۱ آذر ۱۴۰۵</strong> آغاز می‌شود. نتایج را با پرونده رشد بچه‌ها دنبال می‌کنیم و هر سال گزارشش را با خانواده‌ها در میان می‌گذاریم.</p>
    <p class="mt-8" data-reveal><a href="/path/" class="btn-ghost">مسیر رشد ۳ تا ۱۸ سال<Icon name="arrow" size={18} /></a></p>
  </Section>

  <CTA />
</Base>
