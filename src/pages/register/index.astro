---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Pending from '../../components/Pending.astro';
import FormShell from '../../components/FormShell.astro';
import Field from '../../components/Field.astro';
const crumbs = [{ label: 'پیش‌ثبت‌نام و مشاوره' }];
---
<Base title="پیش‌ثبت‌نام و مشاوره · کودک ماهر" description="فرم پیش‌ثبت‌نام و رزرو جلسه مشاوره و بازدید." crumbs={crumbs}>
  <PageHero title="پیش‌ثبت‌نام و رزرو جلسه مشاوره" eyebrow="پیش‌ثبت‌نام" icon="pencil" crumbs={crumbs}
    subtitle="فرم زیر را پر کنید. همکاران ما برای هماهنگی جلسه مشاوره و بازدید با شما تماس می‌گیرند. پر کردن این فرم به معنای ثبت‌نام قطعی نیست." />
  <section class="container-x pb-16">
    <div class="grid gap-10 lg:grid-cols-[1.5fr_1fr]">
      <FormShell id="register-form" submit="ارسال فرم پیش‌ثبت‌نام">
        <Field label="نام و نام خانوادگی والد" name="parent" required autocomplete="name" />
        <Field label="شماره تماس" name="phone" type="tel" required autocomplete="tel" />
        <Field label="نام کودک" name="child" />
        <Field label="سن یا پایه کودک" name="age" required placeholder="مثلاً ۴ سال یا پایه دوم…" />
        <Field label="واحد مورد نظر" name="unit" type="select" required full options={['کودکستان', 'دبستان', 'متوسطه اول', 'متوسطه دوم (خبرم کنید)', 'آموزشگاه زبان', 'آموزشگاه فنی‌وحرفه‌ای']} />
        <Field label="زمان مناسب برای تماس" name="call_time" required placeholder="مثلاً صبح‌ها…" />
        <Field label="چطور با ما آشنا شدید؟" name="source" required />
        <Field label="پرسش یا توضیح" name="note" type="textarea" full />
        <Field label="با استفاده از این اطلاعات برای تماس و پیگیری ثبت‌نام موافقم." name="consent" type="checkbox" required full />
      </FormShell>
      <aside class="space-y-6">
        <div class="card p-6" data-reveal>
          <h2 class="text-xl font-black">مراحل ثبت‌نام</h2>
          <Pending class="mt-3" label="مثلاً: ۱. پیش‌ثبت‌نام ۲. جلسه مشاوره و بازدید ۳. آشنایی با کودک ۴. تکمیل مدارک و ثبت‌نام — تأیید شود" />
        </div>
        <div class="card p-6" data-reveal>
          <h2 class="text-xl font-black">مدارک لازم</h2>
          <Pending class="mt-3" label="فهرست مدارک هر مقطع" />
        </div>
        <p class="text-sm text-ink-soft" data-reveal><a href="/privacy/" class="font-bold underline">حریم خصوصی</a></p>
      </aside>
    </div>
  </section>
</Base>
