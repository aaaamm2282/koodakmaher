---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Pending from '../../components/Pending.astro';
import FormShell from '../../components/FormShell.astro';
import Field from '../../components/Field.astro';
import Icon from '../../components/Icon.astro';
import { registerSteps, documents } from '../../data/site';
import { pageSeo } from '../../data/keywords';
const seo = pageSeo('/register/');
const crumbs = [{ label: 'پیش‌ثبت‌نام و مشاوره' }];
// The slug lets /register/?unit=kindergarten pick the unit (unit pages, old addresses, map listings).
const unitOptions = [
  { value: 'کودکستان', slug: 'kindergarten' },
  { value: 'دبستان', slug: 'primary' },
  { value: 'متوسطه اول', slug: 'middle-school' },
  { value: 'متوسطه دوم (خبرم کنید)', slug: 'high-school' },
  { value: 'آموزشگاه زبان', slug: 'language' },
  { value: 'آموزشگاه فنی‌وحرفه‌ای', slug: 'vocational' },
  { value: 'کارگاه‌های عصر', slug: 'workshops' },
];
---
<Base title={seo.title} description={seo.description} crumbs={crumbs}>
  <PageHero title="پیش‌ثبت‌نام و رزرو جلسه مشاوره" crumbs={crumbs}
    subtitle="فرم زیر را پر کنید. همکاران ما برای هماهنگی جلسه مشاوره و بازدید با شما تماس می‌گیرند. پر کردن این فرم به معنای ثبت‌نام قطعی نیست." />
  <section class="container-x py-14 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
      <FormShell id="register-form" kind="register" submit="ارسال فرم پیش‌ثبت‌نام"
        success={{ title: 'درخواست پیش‌ثبت‌نام شما رسید', text: 'همکاران ما برای هماهنگی جلسه مشاوره و بازدید با شما تماس می‌گیرند. این فرم هنوز ثبت‌نام قطعی نیست.' }}>
        <Field label="نام و نام خانوادگی والد" name="parent" required autocomplete="name" />
        <Field label="شماره تماس" name="phone" type="tel" required autocomplete="tel" />
        <Field label="نام کودک" name="child" />
        <Field label="سن یا پایه کودک" name="age" required maxlength={60} placeholder="مثلاً ۴ سال یا پایه دوم…" />
        <Field label="واحد مورد نظر" name="unit" type="select" required full param="unit" options={unitOptions} />
        <Field label="زمان مناسب برای تماس" name="call_time" required placeholder="مثلاً صبح‌ها…" />
        <Field label="چطور با ما آشنا شدید؟" name="source" required />
        <Field label="پرسش یا توضیح" name="note" type="textarea" full />
        <Field label="با استفاده از این اطلاعات برای تماس و پیگیری ثبت‌نام موافقم." name="consent" type="checkbox" required full />
      </FormShell>
      <aside class="space-y-12">
        <div id="steps" class="scroll-mt-4">
          <h2 class="text-2xl">مراحل ثبت‌نام</h2>
          <ol class="mt-5 border-t border-line">
            {registerSteps.map((s, i) => (
              <li class="flex gap-4 border-b border-line py-4">
                <span class="num text-xl text-saffron">{(i + 1).toLocaleString('fa-IR')}</span>
                <div><p class="font-medium">{s.t}</p><p class="mt-0.5 text-sm text-ink-soft">{s.d}</p></div>
              </li>
            ))}
          </ol>
        </div>
        <div>
          <h2 class="text-2xl">مدارک لازم</h2>
          <div class="mt-5 space-y-3">
            {documents.map((d, i) => (
              <details class="card group" open={i === 0}>
                <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 px-5 py-3 font-medium transition-colors hover:text-accent [&::-webkit-details-marker]:hidden">
                  {d.unit}<Icon name="plus" size={18} class="shrink-0 text-ink-mute transition-transform duration-200 group-open:rotate-45" />
                </summary>
                <ul class="space-y-2 border-t border-line px-5 py-4 text-sm text-ink-soft">
                  {d.items.map((it) => <li class="flex gap-2.5"><span class="mt-[0.7rem] size-1 shrink-0 rounded-full bg-saffron" aria-hidden="true"></span>{it}</li>)}
                  {d.pending && <li><Pending inline label={d.pending} /></li>}
                </ul>
              </details>
            ))}
          </div>
        </div>
        <p class="text-sm text-ink-soft">اطلاعات شما طبق <a href="/privacy/" class="link">سیاست حریم خصوصی</a> نگه‌داری می‌شود.</p>
      </aside>
    </div>
  </section>
</Base>
