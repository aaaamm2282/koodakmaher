---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import { workshops } from '../../data/site';
const crumbs = [{ label: 'کارگاه‌ها' }];
---
<Base title="کارگاه‌های مهارتی کودک ماهر" description="کارگاه‌های خلاقیت، کار با چوب، نقاشی خلاق (از ۴ سال)، هوش مصنوعی (از ۷ سال)، الکترونیک (از ۱۰ سال) و مهارت‌های نرم؛ لایه «تجربه» در متد کودک ماهر." crumbs={crumbs}>
  <PageHero title="کارگاه‌ها؛ جایی که تجربه واقعی اتفاق می‌افتد" kicker="کارگاه‌های مهارتی" crumbs={crumbs}
    subtitle="کارگاه‌ها لایه «تجربه» در متد ما هستند. قبل از هر کارگاه، بچه‌ها چند دقیقه حدس می‌زنند و بعد از آن چند دقیقه بازبینی می‌کنند. هدف این نیست که هر کودک در هر کارگاه ماهر شود؛ هدف این است که کارهای متفاوت را امتحان کند و ببیند در هر کدام چه حالی دارد." />
  <section class="container-x py-14 sm:py-20">
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
      {workshops.map((w) => (
        <li class="card lift overflow-hidden">
          <div class="relative grid aspect-[16/10] place-items-center border-b border-line bg-sand text-ink/20" role="img" aria-label={`جای تصویر کارگاه ${w.n}`}>
            <Icon name={w.icon} size={44} />
            <span class="absolute bottom-3 left-3 text-xs text-ink-mute">جای تصویر</span>
          </div>
          <div class="p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h2 class="text-xl">{w.n}</h2>
              <span class="shrink-0 text-sm text-accent">{w.age ?? 'جلسه روزانه'}</span>
            </div>
            <p class="mt-2 text-ink-soft">{w.d}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="mt-14 grid gap-4 border-t border-line pt-8 md:grid-cols-[1fr_1.4fr] md:gap-12" data-reveal>
      <h2 class="text-2xl">آیا کارگاه‌ها برای کودکان بیرون از مؤسسه هم هست؟</h2>
      <p class="lead">بله. کودکانی که دانش‌آموز ما نیستند هم می‌توانند در نوبت عصر در کارگاه‌ها شرکت کنند. برای اطلاع از زمان‌بندی، فرم پیش‌ثبت‌نام را پر کنید یا با مراکز تماس بگیرید.</p>
    </div>
  </section>
  <CTA />
</Base>
