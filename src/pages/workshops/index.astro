---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { Picture } from 'astro:assets';
import LottieIcon from '../../components/LottieIcon.astro';
import { resolveImage } from '../../lib/images';
import CTA from '../../components/CTA.astro';
import { workshops } from '../../data/site';
import { pageSeo } from '../../data/keywords';
const seo = pageSeo('/workshops/');
const crumbs = [{ label: 'کارگاه‌ها' }];
---
<Base title={seo.title} description={seo.description} crumbs={crumbs}>
  <PageHero title="کارگاه‌های مهارتی کودکان؛ جایی که تجربه واقعی اتفاق می‌افتد" kicker="کارگاه‌های مهارتی" crumbs={crumbs}
    subtitle="کارگاه‌ها لایه «تجربه» در متد ما هستند. قبل از هر کارگاه، بچه‌ها چند دقیقه حدس می‌زنند و بعد از آن چند دقیقه بازبینی می‌کنند. هدف این نیست که هر کودک در هر کارگاه ماهر شود؛ هدف این است که کارهای متفاوت را امتحان کند و ببیند در هر کدام چه حالی دارد." />
  <section class="container-x py-14 sm:py-20">
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
      {workshops.map((w) => {
        const img = w.photo ? resolveImage(w.photo.image) : null;
        return (
        <li class="card lift overflow-hidden" data-lottie-card>
          <div class="relative grid aspect-[16/10] place-items-center overflow-hidden border-b border-line bg-sand text-accent">
            {img
              ? <Picture src={img} alt={w.photo!.alt} formats={['avif', 'webp']} widths={[400, 640, 960]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
              : <LottieIcon name={w.icon} size={56} />}
          </div>
          <div class="p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h2 class="text-xl">{w.n}</h2>
              <span class="shrink-0 text-sm text-accent">{w.age ?? 'جلسه روزانه'}</span>
            </div>
            <p class="mt-2 text-ink-soft">{w.d}</p>
          </div>
        </li>
        );
      })}
    </ul>
    <div class="mt-14 grid gap-4 border-t border-line pt-8 md:grid-cols-[1fr_1.4fr] md:gap-12" data-reveal>
      <h2 class="text-2xl">آیا کارگاه‌ها برای کودکان بیرون از مؤسسه هم هست؟</h2>
      <p class="lead">بله. کودکانی که دانش‌آموز ما نیستند هم می‌توانند در نوبت عصر در کارگاه‌ها شرکت کنند. برای اطلاع از زمان‌بندی، فرم پیش‌ثبت‌نام را پر کنید یا با مراکز تماس بگیرید.</p>
    </div>
  </section>
  <CTA href="/register/?unit=workshops" />
</Base>
