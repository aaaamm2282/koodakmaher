---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
const crumbs = [{ label: 'دفتر اندیشه‌ها' }];
const cats = ['شناخت کودک', 'مهارت‌های نرم', 'انتخاب رشته و مسیر', 'یادگیری در خانه', 'از کلاس‌های ما'];
---
<Base title="دفتر اندیشه‌های کودک ماهر" description="یادداشت‌های کوتاه و کاربردی برای والدین و معلمان، درباره شناخت کودک، مهارت‌های زندگی و انتخاب مسیر." crumbs={crumbs}>
  <PageHero title="دفتر اندیشه‌های کودک ماهر" kicker="مقاله‌ها" crumbs={crumbs}
    subtitle="یادداشت‌های کوتاه و کاربردی برای والدین و معلمان، درباره شناخت کودک، مهارت‌های زندگی و انتخاب مسیر." />
  <section class="container-x py-14 sm:py-20">
    <h2 class="sr-only">دسته‌ها</h2>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 border-b border-line pb-4 text-ink-soft" data-stagger>
      {cats.map((c) => <li>{c}</li>)}
    </ul>
    <div class="mt-12 max-w-xl border-r-2 border-saffron pr-6" data-reveal>
      <p class="font-serif text-2xl font-semibold">به‌زودی</p>
      <p class="mt-2 text-ink-soft">اولین یادداشت‌ها به‌زودی منتشر می‌شوند.</p>
    </div>
  </section>
</Base>
