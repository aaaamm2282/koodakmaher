---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { posts, type Post } from '../../data/posts';
import { site } from '../../data/site';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const fmt = new Intl.DateTimeFormat('fa-IR', { dateStyle: 'long' });
const url = new URL(Astro.url.pathname, Astro.site).href;
const origin = new URL('/', Astro.site).href;
const others = posts.filter((p) => p.slug !== post.slug);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.title,
    description: post.description,
    datePublished: post.date,
    dateModified: post.date,
    inLanguage: 'fa-IR',
    mainEntityOfPage: url,
    image: new URL('/og.png', Astro.site).href,
    author: { '@type': 'Organization', name: site.name, url: origin },
    publisher: { '@id': `${origin}#org` },
    abstract: post.summary.join(' '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'خانه', item: origin },
      { '@type': 'ListItem', position: 2, name: 'راهنمای والدین', item: new URL('/blog/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: post.title, item: url },
    ],
  },
];
---
<Base title={post.title} description={post.description} type="article" schema={schema}>
  <article class="container-x max-w-3xl pt-10">
    <nav aria-label="مسیر صفحه" class="text-sm text-ink-soft">
      <a href="/" class="hover:text-ink">خانه</a> / <a href="/blog/" class="hover:text-ink">راهنمای والدین</a>
    </nav>
    <header class="mt-6" data-reveal>
      <h1 class="text-3xl font-black sm:text-4xl md:text-5xl">{post.title}</h1>
      <p class="mt-4 flex flex-wrap items-center gap-2 text-sm text-ink-soft">
        <Icon name="clock" size={16} />
        <time datetime={post.date}>{fmt.format(new Date(post.date))}</time> · زمان مطالعه {post.readMinutes.toLocaleString('fa-IR')} دقیقه · نوشته‌ی تیم آموزشی {site.brand}
      </p>
    </header>

    <aside class="card mt-8 border-r-8 border-sun p-6" aria-label="خلاصه" data-reveal>
      <h2 class="flex items-center gap-2 text-lg font-black"><Icon name="sparkle" size={20} class="text-coral" />خلاصه در یک نگاه</h2>
      <ul class="mt-3 space-y-2">
        {post.summary.map((s) => <li class="flex gap-2"><Icon name="check" size={18} class="mt-1.5 shrink-0 text-mint" />{s}</li>)}
      </ul>
    </aside>

    <div class="mt-10 space-y-10 text-lg">
      {post.sections.map((s) => (
        <section data-reveal>
          <h2 class="text-2xl font-black">{s.h}</h2>
          {s.p?.map((t) => <p class="mt-4 text-ink-soft">{t}</p>)}
          {s.list && (
            <ul class="mt-4 space-y-3">
              {s.list.map((t) => <li class="flex gap-3"><span class="mt-3 h-2.5 w-2.5 shrink-0 rounded-full bg-coral"></span><span class="text-ink-soft">{t}</span></li>)}
            </ul>
          )}
        </section>
      ))}
    </div>

    <div class="mt-14 rounded-[2rem] bg-sky-soft p-8 text-center" data-reveal="scale">
      <p class="text-2xl font-black">می‌خواهید کودکستان کودک ماهر را از نزدیک ببینید؟</p>
      <a href="/#register" class="btn-primary shimmer mt-5" data-magnetic>رزرو بازدید رایگان</a>
    </div>
  </article>

  <section class="container-x max-w-3xl pt-16" aria-labelledby="more-title">
    <h2 id="more-title" class="text-2xl font-black">مقاله‌های دیگر</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {others.map((p) => (
        <li><a href={`/blog/${p.slug}/`} class="card block p-5 font-bold transition hover:-translate-y-1 hover:text-coral">{p.title}</a></li>
      ))}
    </ul>
  </section>
</Base>
