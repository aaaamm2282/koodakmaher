---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import CTA from '../../components/CTA.astro';
import { pageSeo } from '../../data/keywords';
const seo = pageSeo('/parents/');
const crumbs = [{ label: 'برای والدین' }];
const home = [
  'به‌جای «امروز چه یاد گرفتی؟» بپرسید: «امروز چه حدسی زدی؟ درست درآمد؟»',
  'وقتی حدسش غلط بود، آن را شکست نبینید. بپرسید: «حالا چه چیزی درباره خودت فهمیدی؟»',
  'به او برچسب نزنید («تو ریاضی‌ات ضعیف است»، «تو هنرمندی»). بگذارید خودش با تجربه کشف کند.',
  'کارهای واقعی خانه را به اندازه سنش به او بسپارید.',
];
const reports = [
  { t: 'کارنامه ماهانه', d: 'هر ماه' },
  { t: 'جلسه دیدار با اولیا', d: 'ماهانه، گاهی دوماهه' },
  { t: 'دیدار خصوصی با معلم', d: 'هر هفته' },
  { t: 'کارنامه ترم', d: 'ترم اول در بهمن، ترم دوم در خرداد' },
];
---
<Base title={seo.title} description={seo.description} crumbs={crumbs} progress>
  <PageHero title="شما بخشی از مسیرید" crumbs={crumbs} />

  <Section id="file" title="پرونده رشد کودک چیست؟">
    <p class="mt-6 max-w-3xl font-serif text-lg leading-[2.05]" data-reveal>برای هر کودک یک پرونده رشد ساده نگه داشته می‌شود: آرزوها و علاقه‌هایش در سال‌های مختلف، حدس‌هایش درباره خودش و نتیجه آن‌ها، و تجربه‌هایی که داشته. این پرونده برای مقایسه کودک با دیگران نیست؛ برای این است که خود کودک، شما و ما مسیرش را ببینیم. پرونده رشد با رضایت خانواده نگه داشته می‌شود و فقط در اختیار شما و کادر آموزشی است.</p>
  </Section>

  <Section id="home" title="در خانه چه کنیم؟" tone="white">
    <ol class="mt-10 grid gap-x-12 md:grid-cols-2" data-stagger>
      {home.map((h, i) => <li class="flex gap-5 border-t border-line py-6"><span class="num text-xl text-saffron">{(i + 1).toLocaleString('fa-IR')}</span><p class="text-md">{h}</p></li>)}
    </ol>
  </Section>

  <Section id="progress" title="چطور در جریان پیشرفت فرزندمان هستیم؟">
    <dl class="mt-10 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4" data-stagger>
      {reports.map((r) => <div class="bg-surface p-6"><dt class="font-serif text-xl font-semibold">{r.t}</dt><dd class="mt-2 text-ink-soft">{r.d}</dd></div>)}
    </dl>
  </Section>

  <Section id="promise" title="آنچه ما وعده می‌دهیم و آنچه وعده نمی‌دهیم" tone="sand">
    <div class="mt-10 grid gap-10 md:grid-cols-2" data-stagger>
      <div class="border-t-2 border-accent pt-5">
        <h3 class="text-xl">وعده می‌دهیم</h3>
        <p class="lead mt-3">فرزندتان کارهای متنوع را واقعاً تجربه کند، شاهدهای انتخابش ثبت شود و در انتخاب رشته تنها نماند.</p>
      </div>
      <div class="border-t-2 border-ink/40 pt-5">
        <h3 class="text-xl">وعده نمی‌دهیم</h3>
        <p class="lead mt-3">تضمین رشته یا شغل خاص، یا اینکه این روش جای تلاش خود کودک و تصمیم خانواده را بگیرد.</p>
      </div>
    </div>
  </Section>

  <CTA />
</Base>
