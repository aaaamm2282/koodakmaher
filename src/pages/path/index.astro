---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
import Icon from '../../components/Icon.astro';
import { pageSeo } from '../../data/keywords';
const seo = pageSeo('/path/');

const crumbs = [{ label: 'مسیر رشد ۳ تا ۱۸ سال' }];
const stages = [
  { age: '۳ تا ۵', from: 3, stage: 'کودکستان', focus: 'بازی، کنجکاوی، عادت حدس زدن', form: '«حدس و امتحان» با اشیا و بازی، بدون نوشتن. حدس کودک را تصحیح نمی‌کنیم.', href: '/units/kindergarten/' },
  { age: '۶ تا ۸', from: 6, stage: 'دبستان (دوره اول)', focus: 'شناخت کارها و نقش‌ها', form: 'کارت حدس ساده و چرخش نقش‌ها در کلاس', href: '/units/primary/' },
  { age: '۹ تا ۱۱', from: 9, stage: 'دبستان (دوره دوم)', focus: 'تجربه‌های متنوع، باز نگه داشتن گزینه‌ها', form: 'دفتر پیش‌بینی ساده و کارگاه‌های گوناگون', href: '/units/primary/' },
  { age: '۱۲ تا ۱۴', from: 12, stage: 'متوسطه اول', focus: 'مسئله واقعی و مقایسه مسیرها', form: 'چرخه‌های شش تا هشت هفته‌ای مسئله واقعی و «پرونده انتخاب»', href: '/units/middle-school/' },
  { age: '۱۵', from: 15, stage: 'پایه نهم', focus: 'اولین انتخاب آگاهانه', form: 'انتخاب رشته بر پایه پرونده انتخاب', milestone: true },
  { age: '۱۵ تا ۱۸', from: 15, stage: 'متوسطه دوم', focus: 'واکاوی خود و دنیای آینده', form: 'آزمودن رشته و کار در مقیاس واقعی‌تر', href: '/units/high-school/', soon: true },
  { age: '۱۸', from: 18, stage: 'پایان مسیر', focus: 'انتخاب نهایی', form: 'تصمیم برای دانشگاه یا ورود به کار', milestone: true },
];
const ticks = [3, 6, 9, 12, 15, 18];
// Age dial as a staircase (after "Isometric Steps" on 21st.dev, docs/21st-elements.md): one step per tick, rising
// from right to left in reading direction, each a box seen from the front with its top and right side drawn back
// at (DX, DY). Drawn tallest first so each lower step covers the foot of the one behind it. Each step takes the
// paper colour of its stretch on the home page once reached; the last step, high school (15 to 18), is dashed: it
// opens later.
const W = 29, H0 = 22, RISE = 20, DX = 24, DY = -14, BASE = 158;
const steps = ticks.map((t, k) => {
  const l = 4 + (ticks.length - 1 - k) * W, r = l + W, top = BASE - (H0 + k * RISE);
  return {
    t, k, l, r,
    front: `${l},${top} ${r},${top} ${r},${BASE} ${l},${BASE}`,
    tread: `${l},${top} ${r},${top} ${r + DX},${top + DY} ${l + DX},${top + DY}`,
    riser: `${r},${top} ${r + DX},${top + DY} ${r + DX},${BASE + DY} ${r},${BASE}`,
    cx: (l + r + DX) / 2, cy: top + DY / 2,
    soon: t === 18,
    tone: ({ 3: 'saffron', 6: 'red', 9: 'red', 12: 'teal', 15: 'gold' } as Record<number, string>)[t],
  };
});
---
<Base title={seo.title} description={seo.description} crumbs={crumbs}>
  <PageHero title="یک مسیر پیوسته، نه چند برنامه جدا" subtitle="چرخه پیش‌بینی، تجربه، بازبینی در همه سنین یکی است؛ فقط شکلش با سن کودک عوض می‌شود." crumbs={crumbs} />

  <section class="container-x py-14 sm:py-20" aria-label="مراحل مسیر رشد" data-path>
    <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[15rem_1fr] lg:gap-16">
      <!-- Age dial (decorative): a gold token climbs the staircase 3 → 18 while the stages scroll past. Wide screens only. -->
      <div class="hidden lg:block motion-reduce:lg:hidden" aria-hidden="true">
        <div class="sticky top-28">
          <svg viewBox="0 0 206 162" class="stairs block w-full overflow-visible" focusable="false" data-stairs>
            {[...steps].reverse().map((s) => (
              <g class:list={['stair', s.k === 0 && 'is-on', s.soon && 'is-soon']} data-tone={s.tone} data-step={s.k} data-age={s.t} data-cx={s.cx} data-cy={s.cy}>
                <polygon class="face side" points={s.riser} />
                <polygon class="face top" points={s.tread} />
                <polygon class="face front" points={s.front} />
                <text class="label" x={(s.l + s.r) / 2} y={BASE - 6}>{s.t.toLocaleString('fa-IR')}</text>
              </g>
            ))}
            <ellipse class="token-shadow" cx={steps[0].cx} cy={steps[0].cy} rx="6.5" ry="2" data-token-shadow />
            <circle class="token-ball" cx={steps[0].cx} cy={steps[0].cy - 7.5} r="6.5" data-token />
          </svg>
          <div class="mt-6">
            <p class="text-sm text-ink-mute">سن</p>
            <p class="num mt-1 text-[5.5rem] leading-none text-accent" data-path-age>۳</p>
            <p class="mt-3 text-sm text-ink-mute">سالگی</p>
            <p class="mt-6 max-w-[8rem] font-serif text-lg leading-8" data-path-stage>{stages[0].stage}</p>
          </div>
        </div>
      </div>

      <ol class="relative" data-path-list>
        <span class="absolute top-3 bottom-3 start-[5.5rem] w-px bg-line-strong sm:start-[7.5rem]" aria-hidden="true"></span>
        <span class="absolute top-3 bottom-3 start-[5.5rem] w-0.5 origin-top translate-x-[0.5px] bg-accent sm:start-[7.5rem]" data-timeline-line aria-hidden="true"></span>
        {stages.map((s) => (
          <li class="path-item relative grid grid-cols-[4.5rem_1fr] gap-x-8 pb-12 last:pb-0 sm:grid-cols-[6.5rem_1fr]" data-path-item data-age={s.from} data-stage={s.stage}>
            <p class="num pt-0.5 text-end text-lede leading-tight sm:text-title">{s.age}<span class="block font-sans text-xs text-ink-mute">سال</span></p>
            <span class:list={['path-dot absolute top-2 start-[5.5rem] size-3.5 translate-x-1/2 rounded-full border-2 border-accent sm:start-[7.5rem]', s.milestone ? 'bg-accent' : 'bg-paper']} aria-hidden="true"></span>
            <div class:list={['ps-2', s.milestone && 'rounded-xl bg-forest p-5 text-white']}>
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="text-xl sm:text-2xl">{s.stage}</h2>
                {s.soon && <span class="chip">به‌زودی</span>}
                {s.milestone && <span class="rounded-md bg-white/15 px-1.5 py-px text-xs font-medium">نقطه انتخاب</span>}
              </div>
              <p class:list={['mt-1 font-medium', s.milestone ? 'text-white' : 'text-accent']}>{s.focus}</p>
              <p class:list={['mt-1', s.milestone ? 'text-white/75' : 'text-ink-soft']}>{s.form}</p>
              {s.href && <a href={s.href} class:list={['link mt-2 inline-flex items-center gap-1 text-sm', s.milestone && '!text-gold']}>صفحه واحد<Icon name="arrow" size={14} /></a>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-y border-line bg-sand" aria-labelledby="early-title">
    <div class="container-x grid gap-6 py-14 sm:py-20 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
      <h2 id="early-title" class="section-title">یک نکته مهم برای سال‌های اول</h2>
      <p class="lead">تا حدود ۱۲ سالگی هدف ما «انتخاب» نیست؛ هدف این است که نقشه آنچه کودک ممکن است بشود وسیع بماند. کودکان در سال‌های اول، گزینه‌های زیادی را زود و بی‌آنکه امتحانشان کنند کنار می‌گذارند. ما می‌خواهیم قبل از کنار گذاشتن، تجربه کنند.</p>
    </div>
  </section>

  <CTA />
</Base>

<script>
  import '../../scripts/path-story';
</script>
