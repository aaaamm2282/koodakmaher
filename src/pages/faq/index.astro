---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import CTA from '../../components/CTA.astro';
import { faqs, units } from '../../data/site';
import { pageSeo } from '../../data/keywords';
import { faqPage } from '../../lib/schema';
const seo = pageSeo('/faq/');
const crumbs = [{ label: 'پرسش‌های پرتکرار' }];
// Only fully confirmed answers go into FAQPage structured data (lib/schema.ts).
const schema = [faqPage(faqs)];
// Each unit's own questions live on its page; link there so parents find them.
const unitFaqs = units.filter((u) => u.faqs.length).map((u) => ({ href: `/units/${u.slug}/#unit-faq-title`, label: u.name, n: u.faqs.length }));
---
<Base title={seo.title} description={seo.description} crumbs={crumbs} schema={schema}>
  <PageHero title={seo.h1} kicker="پرسش و پاسخ" crumbs={crumbs} />
  <section class="container-x py-14 sm:py-20">
    <div class="mx-auto grid max-w-5xl gap-12 lg:grid-cols-[1fr_15rem] lg:gap-16">
      <FaqList items={faqs} />
      <aside class="h-fit lg:sticky lg:top-24" data-reveal aria-labelledby="unit-faqs">
        <h2 id="unit-faqs" class="font-sans text-base font-semibold">پرسش‌های هر واحد</h2>
        <ul class="mt-3 border-t border-line text-[0.95rem]">
          {unitFaqs.map((x) => (
            <li class="border-b border-line"><a href={x.href} class="flex items-center justify-between gap-3 py-3 hover:text-accent">{x.label}<span class="num text-sm text-ink-mute">{x.n.toLocaleString('fa-IR')}</span></a></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>
  <CTA />
</Base>
