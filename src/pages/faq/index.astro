---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Pending from '../../components/Pending.astro';
import CTA from '../../components/CTA.astro';
import { faqs } from '../../data/site';
const crumbs = [{ label: 'پرسش‌های پرتکرار' }];
// Only fully confirmed answers go into FAQPage structured data.
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.filter((f) => f.a && !f.pending).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}];
---
<Base title="پرسش‌های پرتکرار · کودک ماهر" description="پاسخ پرسش‌های پرتکرار والدین درباره برنامه درسی، نمره، برچسب استعداد، انتخاب رشته، شهریه، گزارش پیشرفت و متد کودک ماهر." crumbs={crumbs} schema={schema}>
  <PageHero title="پرسش‌های پرتکرار" kicker="پرسش و پاسخ" crumbs={crumbs} />
  <section class="container-x py-14 sm:py-20">
    <div class="mx-auto max-w-3xl border-t border-line" data-stagger>
      {faqs.map((f, i) => (
        <details class="group border-b border-line" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
            <h2 class="text-lg sm:text-xl">{f.q}</h2>
            <span class="mt-1 text-2xl leading-none text-ink-mute transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <div class="space-y-3 pb-6 text-ink-soft">
            {f.a && <p class="leading-[1.95]">{f.a}</p>}
            {f.pending && <Pending inline label={f.pending} />}
          </div>
        </details>
      ))}
    </div>
  </section>
  <CTA />
</Base>
