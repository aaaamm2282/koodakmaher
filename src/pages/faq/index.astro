---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Pending from '../../components/Pending.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import { faqs } from '../../data/site';
const crumbs = [{ label: 'پرسش‌های پرتکرار' }];
// Only fully confirmed answers go into FAQPage structured data.
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.filter((f) => f.a && !f.pending).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}];
---
<Base title="پرسش‌های پرتکرار · کودک ماهر" description="پاسخ پرسش‌های پرتکرار والدین درباره برنامه درسی، نمره، برچسب استعداد، انتخاب رشته و متد کودک ماهر." crumbs={crumbs} schema={schema}>
  <PageHero title="پرسش‌های پرتکرار" eyebrow="پرسش و پاسخ" icon="chat" crumbs={crumbs} />
  <section class="container-x pb-10">
    <div class="mx-auto max-w-3xl space-y-3" data-stagger>
      {faqs.map((f, i) => (
        <details class="card group overflow-hidden" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-lg font-bold [&::-webkit-details-marker]:hidden">
            <h2>{f.q}</h2>
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-sun-soft transition-transform duration-300 group-open:rotate-45"><Icon name="plus" size={18} /></span>
          </summary>
          <div class="space-y-2 px-5 pb-5 text-ink-soft">
            {f.a && <p>{f.a}</p>}
            {f.pending && <Pending inline label={f.pending} />}
          </div>
        </details>
      ))}
    </div>
  </section>
  <CTA />
</Base>
