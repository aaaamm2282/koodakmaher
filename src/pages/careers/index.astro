---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Pending from '../../components/Pending.astro';
import FormShell from '../../components/FormShell.astro';
import Field from '../../components/Field.astro';
import { pageSeo } from '../../data/keywords';
const seo = pageSeo('/careers/');
const crumbs = [{ label: 'همکاری با ما' }];
---
<Base title={seo.title} description={seo.description} crumbs={crumbs}>
  <PageHero title="با ما کار کنید" tagline="همکاری با کودک ماهر" crumbs={crumbs}
    subtitle="دنبال معلمان و مربیانی هستیم که پرسیدن را از جواب دادن مهم‌تر می‌دانند، از کار با کودک لذت می‌برند و آماده یادگیری یک روش تازه‌اند. همکاران ما آموزش متد کودک ماهر را می‌بینند و با فرم‌ها و بازبینی منظم همراهی می‌شوند." />
  <section class="container-x py-14 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.5fr] lg:gap-16">
      <div>
        <h2 class="text-2xl">موقعیت‌های فعلی</h2>
        <Pending class="mt-4" label="فهرست موقعیت‌ها یا «در حال حاضر موقعیت باز نداریم؛ رزومه شما را برای آینده نگه می‌داریم»" />
      </div>
      <FormShell id="careers-form" kind="careers" title="فرم همکاری" submit="ارسال درخواست همکاری"
        success={{ title: 'درخواست همکاری شما رسید', text: 'همکاران ما رزومه شما را می‌خوانند و اگر موقعیت مناسبی باشد، با شما تماس می‌گیرند.' }}>
        <Field label="نام" name="name" required autocomplete="name" />
        <Field label="شماره تماس" name="phone" type="tel" required autocomplete="tel" />
        <Field label="موقعیت مورد نظر" name="position" required full />
        <Field label="تحصیلات و سابقه کوتاه" name="background" type="textarea" required full />
        <Field label="بارگذاری رزومه" name="resume" type="file" required full accept=".pdf,.doc,.docx" acceptLabel="PDF یا Word" maxMb={5} hint="PDF یا Word، حداکثر ۵ مگابایت" />
        <Field label="چرا کودک ماهر؟" name="why" type="textarea" required full maxwords={100} hint="حداکثر ۱۰۰ کلمه" />
      </FormShell>
    </div>
  </section>
</Base>
