---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Pending from '../../components/Pending.astro';
import FormShell from '../../components/FormShell.astro';
import Field from '../../components/Field.astro';
const crumbs = [{ label: 'همکاری با ما' }];
---
<Base title="همکاری با ما · کودک ماهر" description="دنبال معلمان و مربیانی هستیم که پرسیدن را از جواب دادن مهم‌تر می‌دانند." crumbs={crumbs}>
  <PageHero title="با ما کار کنید" eyebrow="همکاری با ما" icon="users" crumbs={crumbs}
    subtitle="دنبال معلمان و مربیانی هستیم که پرسیدن را از جواب دادن مهم‌تر می‌دانند، از کار با کودک لذت می‌برند و آماده یادگیری یک روش تازه‌اند. همکاران ما آموزش متد کودک ماهر را می‌بینند و با فرم‌ها و بازبینی منظم همراهی می‌شوند." />
  <section class="container-x pb-16">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.5fr]">
      <div class="card h-fit p-6" data-reveal>
        <h2 class="text-xl font-black">موقعیت‌های فعلی</h2>
        <Pending class="mt-3" label="فهرست موقعیت‌ها یا «در حال حاضر موقعیت باز نداریم؛ رزومه شما را برای آینده نگه می‌داریم»" />
      </div>
      <FormShell id="careers-form" title="فرم همکاری" submit="ارسال درخواست همکاری">
        <Field label="نام" name="name" required autocomplete="name" />
        <Field label="شماره تماس" name="phone" type="tel" required autocomplete="tel" />
        <Field label="موقعیت مورد نظر" name="position" required full />
        <Field label="تحصیلات و سابقه کوتاه" name="background" type="textarea" required full />
        <Field label="بارگذاری رزومه" name="resume" type="file" required full accept=".pdf,.doc,.docx" hint="PDF یا Word" />
        <Field label="چرا کودک ماهر؟" name="why" type="textarea" required full maxwords={100} hint="حداکثر ۱۰۰ کلمه" />
      </FormShell>
    </div>
  </section>
</Base>
