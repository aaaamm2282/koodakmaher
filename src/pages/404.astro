---
import Base from '../layouts/Base.astro';
---
<Base title="صفحه پیدا نشد · کودک ماهر" noindex>
  <section class="container-x grid min-h-[60vh] place-items-center py-20 text-center">
    <div>
      <p class="float-a text-8xl font-black text-sun" aria-hidden="true">۴۰۴</p>
      <h1 class="mt-6 text-3xl font-black">این صفحه پیدا نشد</h1>
      <p class="mt-3 text-lg text-ink-soft">شاید نشانی را اشتباه وارد کرده‌اید.</p>
      <a href="/" class="btn-primary mt-8">بازگشت به خانه</a>
    </div>
  </section>
</Base>
