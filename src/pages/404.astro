---
import Base from '../layouts/Base.astro';
---
<Base title="صفحه پیدا نشد">
  <section class="container-x grid min-h-[60vh] place-items-center py-20 text-center">
    <div>
      <p class="float-a text-8xl font-black text-sun" aria-hidden="true">۴۰۴</p>
      <h1 class="mt-6 text-3xl font-black">این صفحه قایم‌موشک بازی می‌کند!</h1>
      <p class="mt-3 text-lg text-ink-soft">صفحه‌ای که دنبالش بودید پیدا نشد.</p>
      <a href="/" class="btn-primary mt-8">بازگشت به صفحه اصلی</a>
    </div>
  </section>
</Base>
