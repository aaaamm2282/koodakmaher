---
import UnitPage from '../../../components/unit/UnitPage.astro';
import Pending from '../../../components/Pending.astro';
import { unitBySlug } from '../../../data/site';
import { related } from '../../../lib/related';
const u = unitBySlug('vocational');
---
<UnitPage unit={u} related={related.vocational}>
  <div data-reveal>
    <h2 class="text-2xl">معرفی</h2>
    <Pending class="mt-4" label="فهرست دوره‌ها، مخاطبان (نوجوان/بزرگسال)، مدت دوره‌ها، نوع گواهی‌نامه و مرجع صادرکننده آن" />
  </div>
  <div data-reveal>
    <h2 class="text-2xl">پیوند با مسیر کودک ماهر</h2>
    <p class="lead mt-4">برای نوجوانان متوسطه، این آموزشگاه می‌تواند جایی برای تجربه کوتاه و واقعی یک حرفه باشد؛ تجربه‌ای که به پرونده انتخاب اضافه می‌شود.</p>
    <Pending inline class="mt-2" label="پیشنهادی؛ تأیید شود" />
  </div>
</UnitPage>
