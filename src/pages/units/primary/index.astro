---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import InfoList from '../../../components/InfoList.astro';
import UnitContact from '../../../components/UnitContact.astro';
import CTA from '../../../components/CTA.astro';
import { units, workshops } from '../../../data/site';
const u = units.find((x) => x.slug === 'primary')!;
const crumbs = [{ href: '/units/', label: 'واحدها' }, { label: 'دبستان مهارت‌محور' }];
---
<Base title="دبستان مهارت‌محور کودک ماهر" description="پیش‌دبستانی و دبستان پسرانه غیردولتی کودک ماهر: برنامه رسمی همراه با جلسه روزانه مهارت‌های نرم و کارگاه‌های خلاقیت، چوب، هوش مصنوعی و الکترونیک." crumbs={crumbs}>
  <PageHero title="دبستان مهارت‌محور؛ درس رسمی، همراه با مهارت زندگی" kicker="دبستان مهارت‌محور" subtitle={u.officialName} crumbs={crumbs} />
  <section class="container-x py-14 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.6fr_1fr] lg:gap-16">
      <div class="space-y-14">
        <div class="space-y-4" data-reveal>
          <p class="font-serif text-[1.25rem] leading-[2]">برنامه درسی رسمی آموزش‌وپرورش کامل اجرا می‌شود. در کنار آن، دانش‌آموزان هر روز یک جلسه مهارت‌های نرم و یک جلسه کارگاه دارند.</p>
          <p class="lead">در جلسه مهارت نرم، تصمیم گرفتن، همکاری، گفت‌وگو و مسئولیت‌پذیری تمرین می‌شود. در کارگاه‌ها بچه‌ها چیزی را واقعاً می‌سازند.</p>
          <p class="text-ink-soft">کارگاه‌ها: {workshops.filter((w) => w.age).map((w) => w.n).join('، ')}.</p>
        </div>
        <div data-reveal>
          <h2 class="text-2xl">متد در دبستان</h2>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <div class="card p-6"><p class="text-sm font-medium text-accent">پایه‌های اول و دوم</p><p class="mt-2 text-ink-soft">«کارت حدس» ساده قبل و بعد از فعالیت‌ها، و چرخش نقش‌ها در کلاس تا هر کودک مسئولیت‌های مختلف را تجربه کند.</p></div>
            <div class="card p-6"><p class="text-sm font-medium text-accent">پایه‌های سوم تا ششم</p><p class="mt-2 text-ink-soft">«دفتر پیش‌بینی» که کودک حدس‌ها و نتیجه‌ها را در آن می‌نویسد. از پایه چهارم فاصله حدس و نتیجه در پرونده رشد ثبت می‌شود.</p></div>
          </div>
        </div>
        <div class="border-r-2 border-accent pr-6" data-reveal>
          <h2 class="text-xl">نقش خانواده</h2>
          <p class="mt-2 text-ink-soft">گفت‌وگوی کوتاه در خانه درباره اینکه «امروز چه حدسی زدی و چه شد؟» و شرکت در جلسه‌های بازخورد.</p>
        </div>
        <UnitContact unit={u} />
      </div>
      <InfoList items={[
        { label: 'دوره', value: 'پیش‌دبستانی و دبستان، پسرانه' },
        { label: 'ساعت باز بودن مدرسه', value: '۷ تا ۱۴:۳۰' },
        { label: 'ساعت کلاس‌ها', value: '۸ تا ۱۳:۴۵' },
        { label: 'ظرفیت هر کلاس', value: '۱۵ تا ۲۰ دانش‌آموز' },
        { label: 'شهریه', value: 'در جلسه مشاوره اعلام می‌شود؛ امکان پرداخت اقساطی وجود دارد.' },
      ]} />
    </div>
  </section>
  <CTA />
</Base>
