---
import UnitPage from '../../../components/unit/UnitPage.astro';
import { unitBySlug, workshops } from '../../../data/site';
import { related } from '../../../lib/related';
const u = unitBySlug('primary');
// Only the hours the institute confirmed (۱۴۰۵/۰۸/۲۴)
const day = [
  { time: '۷', label: 'باز شدن مدرسه' },
  { time: '۸', label: 'شروع کلاس‌ها' },
  { label: 'یک جلسه مهارت‌های نرم و یک جلسه کارگاه، در کنار درس‌های رسمی' },
  { time: '۱۳:۴۵', label: 'پایان کلاس‌ها' },
  { time: '۱۴:۳۰', label: 'بسته شدن مدرسه' },
];
---
<UnitPage unit={u} day={day} related={related.primary}>
  <div class="space-y-4" data-reveal>
    <p class="font-serif text-xl leading-[2]">برنامه درسی رسمی آموزش‌وپرورش کامل اجرا می‌شود. در کنار آن، دانش‌آموزان هر روز یک جلسه مهارت‌های نرم و یک جلسه کارگاه دارند.</p>
    <p class="lead">در جلسه مهارت نرم، تصمیم گرفتن، همکاری، گفت‌وگو و مسئولیت‌پذیری تمرین می‌شود. در کارگاه‌ها بچه‌ها چیزی را واقعاً می‌سازند.</p>
    <p class="text-ink-soft">کارگاه‌ها: {workshops.filter((w) => w.age).map((w) => w.n).join('، ')}. <a href="/workshops/" class="link">درباره کارگاه‌ها</a></p>
  </div>
  <div data-reveal>
    <h2 class="text-2xl">متد در دبستان</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      <div class="card p-6"><h3 class="font-sans text-sm font-medium text-accent">پایه‌های اول و دوم</h3><p class="mt-2 text-ink-soft">«کارت حدس» ساده قبل و بعد از فعالیت‌ها، و چرخش نقش‌ها در کلاس تا هر کودک مسئولیت‌های مختلف را تجربه کند.</p></div>
      <div class="card p-6"><h3 class="font-sans text-sm font-medium text-accent">پایه‌های سوم تا ششم</h3><p class="mt-2 text-ink-soft">«دفتر پیش‌بینی» که کودک حدس‌ها و نتیجه‌ها را در آن می‌نویسد. از پایه چهارم فاصله حدس و نتیجه در پرونده رشد ثبت می‌شود.</p></div>
    </div>
  </div>
  <div class="note" data-reveal>
    <h2 class="text-xl">نقش خانواده</h2>
    <p class="mt-2 text-ink-soft">گفت‌وگوی کوتاه در خانه درباره اینکه «امروز چه حدسی زدی و چه شد؟» و شرکت در جلسه‌های بازخورد. <a href="/parents/" class="link">برای والدین</a></p>
  </div>
</UnitPage>
