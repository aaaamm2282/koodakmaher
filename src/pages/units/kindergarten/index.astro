---
import UnitPage from '../../../components/unit/UnitPage.astro';
import { unitBySlug } from '../../../data/site';
import { related } from '../../../lib/related';
const u = unitBySlug('kindergarten');
const experiences = ['بازی آزاد و هدایت‌شده', 'فعالیت‌های خلاقیت و نقاشی', 'مسئولیت‌های کوچک (مثل مرتب کردن وسایل یا کمک به دوستان)', 'آشنایی با کارها و شغل‌ها از راه بازی نقش'];
const steps = [['حدس بزن', '«فکر می‌کنی این برج چند تا مکعب می‌خورد تا بیفتد؟»'], ['امتحان کن', 'بچه‌ها برج را می‌سازند.'], ['ببین چه شد', 'با هم نگاه می‌کنیم که چه شد؛ بدون درست و غلط.']];
// Only the hours the institute confirmed (۱۴۰۵/۰۸/۲۴)
const day = [
  { time: '۷:۳۰', label: 'شروع ساعت کار کودکستان' },
  { time: '۸:۳۰', label: 'شروع برنامه آموزشی' },
  { time: '۱۳', label: 'پایان برنامه آموزشی' },
  { time: '۱۴', label: 'پایان ساعت کار کودکستان' },
];
---
<UnitPage unit={u} day={day} related={related.kindergarten}>
  <div class="space-y-4" data-reveal>
    <p class="font-serif text-xl leading-[2]">در سنین ۳ تا ۵ سال، کودک با بازی یاد می‌گیرد. در کودکستان ما بچه‌ها پیش از هر بازی یا فعالیت، به زبان خودشان حدس می‌زنند، بعد امتحان می‌کنند و با هم نگاه می‌کنند که چه شد.</p>
    <p class="lead">در این سن دقت حدس مهم نیست و آن را نمی‌سنجیم. کودکان کوچک معمولاً خوش‌بینانه حدس می‌زنند و این طبیعی است. ما فقط عادت «حدس بزن، امتحان کن، ببین چه شد» را می‌سازیم.</p>
  </div>
  <ol class="grid border-y border-line sm:grid-cols-3" data-stagger aria-label="یک فعالیت نمونه">
    {steps.map(([t, d], i) => (
      <li class:list={['py-6 sm:px-6', i > 0 && 'border-t border-line sm:border-t-0 sm:border-s', i === 0 && 'sm:ps-0']}>
        <span class="num text-2xl text-saffron">{(i + 1).toLocaleString('fa-IR')}</span>
        <p class="mt-2 font-serif text-lg font-semibold">{t}</p>
        <p class="mt-1 text-sm text-ink-soft">{d}</p>
      </li>
    ))}
  </ol>
  <div data-reveal>
    <h2 class="text-2xl">آنچه کودک تجربه می‌کند</h2>
    <ul class="mt-5 grid gap-x-8 sm:grid-cols-2">
      {experiences.map((e) => <li class="border-t border-line py-3.5">{e}</li>)}
    </ul>
  </div>
</UnitPage>
