---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import InfoList from '../../../components/InfoList.astro';
import UnitContact from '../../../components/UnitContact.astro';
import CTA from '../../../components/CTA.astro';
import { site, units } from '../../../data/site';
const u = units.find((x) => x.slug === 'kindergarten')!;
const crumbs = [{ href: '/units/', label: 'واحدها' }, { label: 'کودکستان' }];
const experiences = ['بازی آزاد و هدایت‌شده', 'فعالیت‌های خلاقیت و نقاشی', 'مسئولیت‌های کوچک (مثل مرتب کردن وسایل یا کمک به دوستان)', 'آشنایی با کارها و شغل‌ها از راه بازی نقش'];
const steps = [['حدس بزن', '«فکر می‌کنی این برج چند تا مکعب می‌خورد تا بیفتد؟»'], ['امتحان کن', 'بچه‌ها برج را می‌سازند.'], ['ببین چه شد', 'با هم نگاه می‌کنیم که چه شد؛ بدون درست و غلط.']];
---
<Base title={`کودکستان کودک ماهر${site.city ? ` در ${site.city}` : ''}`} description="بازی، حدس زدن و امتحان کردن؛ اولین قدم‌های شناخت خود برای کودکان ۳ تا ۶ سال." crumbs={crumbs}>
  <PageHero title="کودکستان کودک ماهر؛ جایی برای حدس زدن و امتحان کردن" kicker="کودکستان" crumbs={crumbs} />
  <section class="container-x py-14 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.6fr_1fr] lg:gap-16">
      <div class="space-y-14">
        <div class="space-y-4" data-reveal>
          <p class="font-serif text-[1.25rem] leading-[2]">در سنین ۳ تا ۵ سال، کودک با بازی یاد می‌گیرد. در کودکستان ما بچه‌ها پیش از هر بازی یا فعالیت، به زبان خودشان حدس می‌زنند، بعد امتحان می‌کنند و با هم نگاه می‌کنند که چه شد.</p>
          <p class="lead">در این سن دقت حدس مهم نیست و آن را نمی‌سنجیم. کودکان کوچک معمولاً خوش‌بینانه حدس می‌زنند و این طبیعی است. ما فقط عادت «حدس بزن، امتحان کن، ببین چه شد» را می‌سازیم.</p>
        </div>
        <ol class="grid border-y border-line sm:grid-cols-3" data-stagger>
          {steps.map(([t, d], i) => (
            <li class:list={['py-6 sm:px-6', i > 0 && 'border-t border-line sm:border-t-0 sm:border-r', i === 0 && 'sm:pr-0']}>
              <span class="num text-2xl text-saffron">{(i + 1).toLocaleString('fa-IR')}</span>
              <h3 class="mt-2 text-lg">{t}</h3>
              <p class="mt-1 text-sm text-ink-soft">{d}</p>
            </li>
          ))}
        </ol>
        <div data-reveal>
          <h2 class="text-2xl">آنچه کودک تجربه می‌کند</h2>
          <ul class="mt-5 grid gap-x-8 sm:grid-cols-2">
            {experiences.map((e) => <li class="border-t border-line py-3.5">{e}</li>)}
          </ul>
        </div>
        <UnitContact unit={u} />
      </div>
      <InfoList items={[
        { label: 'سن پذیرش', value: u.ages! },
        { label: 'ساعت کار', value: '۷:۳۰ تا ۱۴' },
        { label: 'ساعت آموزش', value: '۸:۳۰ تا ۱۳' },
        { label: 'شهریه امسال', value: '۴۵ میلیون (ثابت)', pending: 'واحد مبلغ (تومان یا ریال)' },
        { label: 'شهریه مصوب اداره', value: '۷۰ میلیون' },
        { label: 'ظرفیت هر گروه و نسبت مربی به کودک', pending: 'عدد واقعی' },
      ]} />
    </div>
  </section>
  <CTA />
</Base>
