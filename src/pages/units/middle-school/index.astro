---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import InfoList from '../../../components/InfoList.astro';
import UnitContact from '../../../components/UnitContact.astro';
import CTA from '../../../components/CTA.astro';
import { units } from '../../../data/site';
const u = units.find((x) => x.slug === 'middle-school')!;
const crumbs = [{ href: '/units/', label: 'واحدها' }, { label: 'متوسطه اول پسرانه' }];
const file = ['تجربه‌هایی که دانش‌آموز واقعاً داشته', 'حدس‌هایش درباره خودش و مقایسه آن‌ها با نتیجه', 'مقایسه دست‌کم سه گزینه رشته یا مسیر', 'دلیل انتخاب، به زبان خود دانش‌آموز'];
const grades = [
  { g: 'هفتم', d: 'تجربه و بازتاب' },
  { g: 'هشتم', d: 'مقایسه دو مسیر' },
  { g: 'نهم', d: 'انتخاب موقت برای ۱۵ سالگی، در هماهنگی با مشاور مدرسه و فرایند رسمی هدایت تحصیلی' },
];
---
<Base title="متوسطه اول پسرانه کودک ماهر" description="دبیرستان ماهر مانا: مسئله‌های واقعی و پرونده انتخاب برای انتخاب رشته آگاهانه در پایه نهم." crumbs={crumbs}>
  <PageHero title="متوسطه اول؛ آماده شدن برای اولین انتخاب بزرگ" kicker="متوسطه اول پسرانه" subtitle={u.officialName} crumbs={crumbs} />
  <section class="container-x py-14 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.6fr_1fr] lg:gap-16">
      <div class="space-y-14">
        <p class="font-serif text-[1.25rem] leading-[2]" data-reveal>پایه‌های هفتم تا نهم آخرین سال‌ها پیش از انتخاب رشته در ۱۵ سالگی است. در این دوره، دانش‌آموزان در چرخه‌های شش تا هشت هفته‌ای روی یک مسئله واقعی کار می‌کنند: پیش‌بینی می‌کنند، کار را انجام می‌دهند، با افراد شاغل گفت‌وگو می‌کنند و نتیجه را بازبینی می‌کنند. حاصل این چرخه‌ها «پرونده انتخاب» هر دانش‌آموز است.</p>
        <div data-reveal>
          <h2 class="text-2xl">پرونده انتخاب شامل:</h2>
          <ul class="mt-5 grid gap-x-8 sm:grid-cols-2">{file.map((f) => <li class="border-t border-line py-3.5">{f}</li>)}</ul>
        </div>
        <div data-reveal>
          <h2 class="text-2xl">پایه‌به‌پایه</h2>
          <ol class="mt-6 grid border-y border-line md:grid-cols-3">
            {grades.map((g, i) => <li class:list={['py-6 md:px-6', i > 0 && 'border-t border-line md:border-t-0 md:border-r', i === 0 && 'md:pr-0']}><p class="font-serif text-xl font-semibold">پایه {g.g}</p><p class="mt-2 text-ink-soft">{g.d}</p></li>)}
          </ol>
        </div>
        <div class="border-r-2 border-accent pr-6" data-reveal>
          <p><strong>یک نکته شفاف:</strong> <span class="text-ink-soft">پرونده انتخاب جایگزین فرایند رسمی هدایت تحصیلی نیست؛ کنار آن و برای آگاهانه‌تر کردن تصمیم است.</span></p>
        </div>
        <UnitContact unit={u} />
      </div>
      <InfoList items={[
        { label: 'ساعت کار', value: '۷ تا ۱۴:۱۰' },
        { label: 'روزهای کاری', value: 'همه روزها به‌جز پنجشنبه و جمعه' },
        { label: 'ظرفیت هر کلاس', value: '۱۸ تا ۲۰ دانش‌آموز' },
        { label: 'شهریه', pending: 'مبلغ یا «در جلسه مشاوره اعلام می‌شود»' },
      ]} />
    </div>
  </section>
  <CTA />
</Base>
