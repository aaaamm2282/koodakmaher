---
import UnitPage from '../../../components/unit/UnitPage.astro';
import { unitBySlug } from '../../../data/site';
import { related } from '../../../lib/related';
const u = unitBySlug('middle-school');
const file = ['تجربه‌هایی که دانش‌آموز واقعاً داشته', 'حدس‌هایش درباره خودش و مقایسه آن‌ها با نتیجه', 'مقایسه دست‌کم سه گزینه رشته یا مسیر', 'دلیل انتخاب، به زبان خود دانش‌آموز'];
const grades = [
  { g: 'هفتم', d: 'تجربه و بازتاب' },
  { g: 'هشتم', d: 'مقایسه دو مسیر' },
  { g: 'نهم', d: 'انتخاب موقت برای ۱۵ سالگی، در هماهنگی با مشاور مدرسه و فرایند رسمی هدایت تحصیلی' },
];
---
<UnitPage unit={u} related={related['middle-school']}>
  <p class="font-serif text-xl leading-[2]" data-reveal>پایه‌های هفتم تا نهم آخرین سال‌ها پیش از انتخاب رشته در ۱۵ سالگی است. در این دوره، دانش‌آموزان در چرخه‌های شش تا هشت هفته‌ای روی یک مسئله واقعی کار می‌کنند: پیش‌بینی می‌کنند، کار را انجام می‌دهند، با افراد شاغل گفت‌وگو می‌کنند و نتیجه را بازبینی می‌کنند. حاصل این چرخه‌ها «پرونده انتخاب» هر دانش‌آموز است.</p>
  <div data-reveal>
    <h2 class="text-2xl">پرونده انتخاب شامل:</h2>
    <ul class="mt-5 grid gap-x-8 sm:grid-cols-2">{file.map((f) => <li class="border-t border-line py-3.5">{f}</li>)}</ul>
  </div>
  <div data-reveal>
    <h2 class="text-2xl">پایه‌به‌پایه</h2>
    <ol class="mt-6 grid border-y border-line md:grid-cols-3">
      {grades.map((g, i) => <li class:list={['py-6 md:px-6', i > 0 && 'border-t border-line md:border-t-0 md:border-s', i === 0 && 'md:ps-0']}><h3 class="font-serif text-xl font-semibold">پایه {g.g}</h3><p class="mt-2 text-ink-soft">{g.d}</p></li>)}
    </ol>
  </div>
  <div class="note" data-reveal>
    <p><strong>یک نکته شفاف:</strong> <span class="text-ink-soft">پرونده انتخاب جایگزین فرایند رسمی هدایت تحصیلی نیست؛ کنار آن و برای آگاهانه‌تر کردن تصمیم است.</span></p>
  </div>
</UnitPage>
