---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Pending from '../../components/Pending.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import { site } from '../../data/site';

const crumbs = [{ label: 'درباره ما' }];
const values = [
  { t: 'کودک مرکز است، نه نمره.', d: 'نمره را کنار نمی‌گذاریم، ولی آن را تنها معیار نمی‌دانیم.' },
  { t: 'تجربه قبل از برچسب.', d: 'هیچ کودکی را با یک کارگاه یا یک نمره «دسته‌بندی» نمی‌کنیم.' },
  { t: 'صداقت با خانواده.', d: 'آنچه را می‌دانیم می‌گوییم و آنچه را هنوز در حال آزمودنش هستیم هم می‌گوییم.' },
  { t: 'سیستم، نه وابستگی به یک نفر.', d: 'کیفیت آموزش باید با فرایند، فرم و بازبینی منظم حفظ شود.' },
  { t: 'همکاری با خانواده.', d: 'خانواده بخشی از مسیر است، نه فقط تماشاگر آن.' },
];
---
<Base title="درباره ما · کودک ماهر مانا" description="کودک ماهر مانا؛ یک مدرسه مهارت‌محور شامل کودکستان، دبستان مهارت‌محور، متوسطه اول پسرانه، آموزشگاه زبان و آموزشگاه آزاد فنی‌وحرفه‌ای." crumbs={crumbs}>
  <PageHero title="کودک ماهر مانا؛ یک مدرسه مهارت‌محور" eyebrow="درباره ما" crumbs={crumbs} />

  <section class="container-x pb-10">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div class="space-y-5 text-lg leading-loose" data-reveal>
        <p>کودک ماهر مانا را با یک باور ساده راه انداختیم: آموزش نباید فقط به دانستن و موفقیت در امتحان محدود شود؛ باید انسان را برای زندگی آماده کند.</p>
        <p class="text-ink-soft">می‌خواهیم کودکان و نوجوانان از کودکی تا ورود به زندگی حرفه‌ای خودشان را بشناسند، توانایی‌هایشان را کشف کنند، درست فکر کردن و تصمیم گرفتن را یاد بگیرند، مسئولیت‌پذیر و خلاق شوند و بتوانند مسئله‌های واقعی زندگی را حل کنند.</p>
        <p class="text-ink-soft">امروز مؤسسه شامل کودکستان، دبستان مهارت‌محور، متوسطه اول پسرانه، آموزشگاه زبان و آموزشگاه آزاد فنی‌وحرفه‌ای است. برخی از دانش‌آموزان امروز ما از کودکستان با ما بوده‌اند.</p>
      </div>
      <dl class="card h-fit space-y-5 p-6" data-reveal>
        <div><dt class="text-sm font-bold text-ink-soft">سال تأسیس</dt><dd class="mt-1">{site.foundingYear ?? <Pending inline label="سال تأسیس" />}</dd></div>
        <div><dt class="text-sm font-bold text-ink-soft">مجوزها</dt><dd class="mt-1"><Pending inline label="نام و شماره مجوز هر واحد از مرجع صادرکننده" /></dd></div>
      </dl>
    </div>
  </section>

  <Section title="آنچه به آن پایبندیم" id="values">
    <ol class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-stagger>
      {values.map((v, i) => (
        <li class="spotlight card flex gap-4 p-6">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-sun text-lg font-black">{(i + 1).toLocaleString('fa-IR')}</span>
          <div><h3 class="text-lg font-black">{v.t}</h3><p class="mt-1 text-ink-soft">{v.d}</p></div>
        </li>
      ))}
    </ol>
  </Section>

  <Section title="پیام مؤسس" id="founder">
    <figure class="card mt-10 grid gap-8 p-7 sm:p-10 md:grid-cols-[200px_1fr]" data-reveal>
      <div class="grid aspect-square w-full max-w-[200px] place-items-center rounded-[2rem] border-2 border-dashed border-ink/20 bg-cream text-ink/30" role="img" aria-label="جای عکس مؤسس">
        <Icon name="users" size={56} />
      </div>
      <div>
        <Icon name="quote" size={32} class="text-sun" />
        <blockquote class="mt-3"><Pending label="متن کوتاه به قلم خود مؤسس، ۱۰۰ تا ۱۵۰ کلمه: چرا کودک ماهر را ساختید، چه چیزی در تجربه آموزش مهارتی شما را به این راه رساند، و از خانواده‌ها چه انتظاری دارید." /></blockquote>
        <figcaption class="mt-5">
          <p class="text-xl font-black">{site.founder}</p>
          <p class="text-ink-soft">بنیان‌گذار {site.name}</p>
          <Pending inline class="mt-2" label="عنوان‌ها و سوابقی که مؤسس می‌خواهد عمومی شود" />
        </figcaption>
      </div>
    </figure>
  </Section>

  <Section title="تیم ما" id="team">
    <Pending class="mt-8" label="نام و نقش مدیران هر واحد (در صورت تمایل با عکس). اگر نام‌ها عمومی نشود، این بخش حذف می‌شود." />
  </Section>

  <CTA />
</Base>
