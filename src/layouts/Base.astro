---
import '../styles/global.css';
import vazirArabic from '@fontsource-variable/vazirmatn/files/vazirmatn-arabic-wght-normal.woff2?url';
import naskhArabic from '@fontsource-variable/noto-naskh-arabic/files/noto-naskh-arabic-arabic-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, social, units } from '../data/site';

interface Props {
  /** Full <title>, exactly as in section 5 of the content brief */
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  crumbs?: { href?: string; label: string }[];
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const defaultDescription = `مؤسسه آموزشی مهارت‌محور${site.city ? ` در ${site.city}` : ''}: کودکستان، دبستان، متوسطه اول، آموزشگاه زبان و فنی‌وحرفه‌ای.`;
const {
  title = `کودک ماهر مانا · ${site.slogan}`,
  description = defaultDescription,
  image = '/og.png',
  type = 'website',
  crumbs = [],
  schema = [],
  noindex = false,
} = Astro.props;
const fullTitle = title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const origin = new URL('/', Astro.site).href;

// schema.org school types per unit (more specific than EducationalOrganization helps local results)
const schemaType: Record<string, string> = { kindergarten: 'Preschool', primary: 'ElementarySchool', 'middle-school': 'MiddleSchool' };
// Only confirmed facts go into structured data; unknown values (null in site.ts) are left out.
const orgSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  '@id': `${origin}#org`,
  name: site.name,
  alternateName: [site.brand, 'کودک ماهر مانا', 'ماهر مانا', 'Maher Mana'],
  slogan: site.slogan,
  description: site.mission,
  url: origin,
  logo: new URL('/logo.png', Astro.site).href,
  image: ogImage,
  founder: { '@type': 'Person', name: site.founder },
  department: units.filter((u) => !u.soon).map((u) => ({
    '@type': schemaType[u.slug] ?? 'EducationalOrganization',
    '@id': new URL(`/units/${u.slug}/#unit`, Astro.site).href,
    name: u.officialName ?? `${u.name} کودک ماهر`,
    url: new URL(`/units/${u.slug}/`, Astro.site).href,
    ...(u.address && { address: { '@type': 'PostalAddress', streetAddress: u.address, ...(site.city && { addressLocality: site.city }), addressCountry: 'IR' } }),
    ...(u.phone && { telephone: u.phone.tel }),
    ...(u.mapUrl && { hasMap: u.mapUrl }),
  })),
};
if (site.phone) orgSchema.telephone = site.phone;
if (site.address || site.city) orgSchema.address = { '@type': 'PostalAddress', ...(site.address && { streetAddress: site.address }), ...(site.city && { addressLocality: site.city }), addressCountry: 'IR' };
// foundingYear is a Persian (Hijri Shamsi) year, which schema.org foundingDate (ISO 8601) can't express; it stays in visible text only.
if (social.length) orgSchema.sameAs = social.map((s) => s.href);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${origin}#website`,
  name: site.name,
  url: origin,
  inLanguage: 'fa-IR',
  publisher: { '@id': `${origin}#org` },
};
const crumbSchema = crumbs.length
  ? [{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ label: 'خانه', href: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.label,
        item: new URL(c.href ?? Astro.url.pathname, Astro.site).href,
      })),
    }]
  : [];
// On a unit page, describe that unit on its own too (linked to the parent organisation).
const unitMatch = Astro.url.pathname.match(/^\/units\/([^/]+)\/$/);
const pageUnit = unitMatch ? units.find((x) => x.slug === unitMatch[1] && !x.soon) : undefined;
const unitSchema = pageUnit
  ? [{
      '@context': 'https://schema.org',
      '@type': schemaType[pageUnit.slug] ?? 'EducationalOrganization',
      '@id': new URL(`/units/${pageUnit.slug}/#unit`, Astro.site).href,
      name: pageUnit.officialName ?? `${pageUnit.name} کودک ماهر`,
      url: canonical,
      parentOrganization: { '@id': `${origin}#org` },
      ...(pageUnit.short && { description: pageUnit.short }),
      ...(pageUnit.address && { address: { '@type': 'PostalAddress', streetAddress: pageUnit.address, ...(site.city && { addressLocality: site.city }), addressCountry: 'IR' } }),
      ...(pageUnit.phone && { telephone: pageUnit.phone.tel }),
      ...(pageUnit.mapUrl && { hasMap: pageUnit.mapUrl }),
      ...(pageUnit.instagram && { sameAs: [`https://instagram.com/${pageUnit.instagram.slice(1)}`] }),
      ...(pageUnit.manager && { employee: { '@type': 'Person', name: pageUnit.manager, jobTitle: `مدیر ${pageUnit.name}` } }),
    }]
  : [];
const allSchema = [orgSchema, websiteSchema, ...unitSchema, ...crumbSchema, ...schema];
---
<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <meta name="theme-color" content="#01237a" />
    <link rel="preload" href={vazirArabic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={naskhArabic} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="overflow-x-hidden">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:right-3 focus:z-[100] focus:rounded-lg focus:bg-ink focus:px-5 focus:py-3 focus:text-white">پرش به محتوای اصلی</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <!-- Mobile: quick actions stay within thumb reach once the visitor has scrolled past the first screen -->
    <div id="quickbar" class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-line bg-paper/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur transition-transform duration-300 data-[show=true]:translate-y-0 sm:hidden" data-show="false">
      <div class="flex gap-2">
        <a href="/register/" class="btn-primary flex-1 !min-h-11">پیش‌ثبت‌نام و مشاوره</a>
        <a href="/contact/" class="btn-ghost !min-h-11">تماس</a>
      </div>
    </div>
    <script>
      import '../scripts/motion';
      const qb = document.getElementById('quickbar');
      if (qb && !location.pathname.startsWith('/register')) {
        const on = () => (qb.dataset.show = String(scrollY > innerHeight * 0.8 && innerHeight + scrollY < document.body.scrollHeight - 200));
        on(); addEventListener('scroll', on, { passive: true });
      }
    </script>
  </body>
</html>
