---
/**
 * The statistics script itself. Rendered by Analytics.astro only when a service is set up, so pages
 * without statistics carry none of this code. Reads its settings from <meta name="km-analytics">.
 */
---
<script>
  import type { TrackParams } from '../lib/track';

  type Event = [string, TrackParams];
  type Win = {
    kmq?: Event[];
    dataLayer?: unknown[];
    gtag?: (...args: unknown[]) => void;
    umami?: { track: (name: string, data?: Record<string, unknown>) => void };
  };
  const w = window as unknown as Win;
  const meta = document.querySelector<HTMLMetaElement>('meta[name="km-analytics"]');
  const cfg: { ga?: string; umamiSrc?: string; umamiId?: string } = meta ? JSON.parse(meta.content) : {};
  const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
  const optedOut = nav.doNotTrack === '1' || nav.globalPrivacyControl === true;

  const idle = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 2000 }) : setTimeout(fn, 1));
  function addScript(src: string, attrs: Record<string, string> = {}) {
    const s = document.createElement('script');
    s.async = true;
    s.src = src;
    Object.entries(attrs).forEach(([k, v]) => s.setAttribute(k, v));
    document.head.append(s);
    return s;
  }

  /** Which map a link opens, if any. */
  function mapApp(url: URL) {
    const h = url.hostname.replace(/^www\./, '');
    if (/(^|\.)(nshn\.ir|neshan\.org)$/.test(h)) return 'neshan';
    if (/(^|\.)balad\.ir$/.test(h)) return 'balad';
    if (h === 'maps.app.goo.gl' || /^maps\.google\./.test(h) || (/^google\.[a-z.]+$/.test(h) && url.pathname.startsWith('/maps')) || (h === 'goo.gl' && url.pathname.startsWith('/maps'))) return 'google';
    return null;
  }
  /** Which social network or messenger a link opens, if any. */
  function socialNetwork(url: URL) {
    const h = url.hostname.replace(/^www\./, '');
    const known: [RegExp, string][] = [
      [/(^|\.)instagram\.com$/, 'instagram'], [/^(t\.me|telegram\.me)$/, 'telegram'], [/(^|\.)eitaa\.com$/, 'eitaa'],
      [/(^|\.)shad\.ir$/, 'shad'], [/^ble\.ir$/, 'bale'], [/^(wa\.me|(api\.)?whatsapp\.com)$/, 'whatsapp'],
      [/(^|\.)aparat\.com$/, 'aparat'], [/(^|\.)linkedin\.com$/, 'linkedin'],
    ];
    return known.find(([re]) => re.test(h))?.[1] ?? null;
  }

  if (!optedOut && (cfg.ga || (cfg.umamiSrc && cfg.umamiId))) {
    const umami = Boolean(cfg.umamiSrc && cfg.umamiId);
    const waiting: [string, Record<string, unknown>][] = [];
    let umamiReady = false;

    if (cfg.ga) {
      w.dataLayer = w.dataLayer || [];
      // Google's snippet: gtag pushes the `arguments` object itself.
      w.gtag = function gtag() {
        // eslint-disable-next-line prefer-rest-params
        w.dataLayer!.push(arguments);
      };
      w.gtag('js', new Date());
      w.gtag('config', cfg.ga);
    }

    const send = ([name, params]: Event) => {
      const data = Object.fromEntries(Object.entries(params).filter(([, v]) => v !== undefined && v !== ''));
      w.gtag?.('event', name, data);
      if (umami) {
        if (umamiReady && w.umami) w.umami.track(name, data);
        else waiting.push([name, data]);
      }
    };

    const load = () => {
      if (cfg.ga) addScript(`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(cfg.ga)}`);
      if (umami) {
        addScript(cfg.umamiSrc!, { 'data-website-id': cfg.umamiId!, 'data-do-not-track': 'true' }).addEventListener('load', () => {
          umamiReady = true;
          waiting.splice(0).forEach(([n, d]) => w.umami?.track(n, d));
        });
      }
    };
    if (document.readyState === 'complete') idle(load);
    else addEventListener('load', () => idle(load), { once: true });

    // Events from page scripts (src/lib/track.ts): those already waiting, then each new one as it comes.
    const q = (w.kmq ||= []);
    q.splice(0).forEach(send);
    q.push = (...items: Event[]) => {
      items.forEach(send);
      return q.length;
    };

    // Clicks worth counting, recognised by where the link goes.
    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
      if (!a) return;
      const unit = a.dataset.unit || a.closest<HTMLElement>('[data-unit]')?.dataset.unit;
      if (a.dataset.track === 'review') return send(['review', { unit, app: a.dataset.mapApp }]);
      const href = a.getAttribute('href') || '';
      if (href.startsWith('tel:')) return send(['click_phone', { unit }]);
      if (href.startsWith('mailto:')) return send(['click_email', { unit }]);
      let url: URL;
      try { url = new URL(a.href); } catch { return; }
      const app = mapApp(url);
      if (app) return send(['click_map', { app, unit }]);
      const network = socialNetwork(url);
      if (network) return send(['social', { network, unit }]);
      if (url.host === location.host && url.pathname === '/register/') {
        send(['cta', { unit: url.searchParams.get('unit') || unit, placement: a.dataset.cta }]);
      }
    }, { capture: true });
  }
</script>
