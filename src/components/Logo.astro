---
// Temporary monogram until the institute's real logo file is provided.
// A rising path with three stops: the 3 → 15 → 18 journey.
interface Props { class?: string; light?: boolean }
const { class: cls = '', light = false } = Astro.props;
---
<svg viewBox="0 0 40 40" class={cls} aria-hidden="true">
  <rect width="40" height="40" rx="9" fill={light ? '#ffffff' : '#1e5b47'} />
  <path d="M9 29c6 0 8-4 11-9s5-9 11-9" fill="none" stroke={light ? '#1e5b47' : '#ffffff'} stroke-width="2.4" stroke-linecap="round" />
  <circle cx="9" cy="29" r="2.6" fill={light ? '#1e5b47' : '#ffffff'} />
  <circle cx="20" cy="20" r="2.6" fill={light ? '#1e5b47' : '#ffffff'} />
  <circle cx="31" cy="11" r="2.6" fill="#e0a43a" />
</svg>
