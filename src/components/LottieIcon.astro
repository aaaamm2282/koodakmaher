---
// A line icon that draws itself once when it scrolls into view (Lottie, src/assets/lottie/<name>.json,
// generated from Icon.astro by scripts/make-lottie.mjs). The plain SVG icon is shown until the
// player has loaded, and stays as-is without JS or with "reduce motion" on.
import Icon from './Icon.astro';
interface Props { name: string; size?: number; class?: string }
const { name, size = 44, class: cls = '' } = Astro.props;
const files = import.meta.glob<Record<string, unknown>>('../assets/lottie/*.json', { eager: true, import: 'default' });
const data = files[`../assets/lottie/${name}.json`];
---
<span class:list={['lottie-icon inline-grid place-items-center', cls]} style={`width:${size}px;height:${size}px`} data-lottie aria-hidden="true">
  <Icon name={name} size={size} class="lottie-fallback" />
  {data && <script type="application/json" set:html={JSON.stringify(data)} />}
</span>

<script>
  // The player (lottie_light, ~47 KB gzipped) is fetched only when the first icon comes near the screen.
  const icons = document.querySelectorAll<HTMLElement>('[data-lottie]');
  if (icons.length && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    let player: Promise<typeof import('lottie-web')['default']> | undefined;
    const load = () => (player ??= import('lottie-web/build/player/lottie_light').then((m) => (m.default ?? m) as typeof import('lottie-web')['default']));
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (!en.isIntersecting) continue;
        io.unobserve(en.target);
        const el = en.target as HTMLElement;
        const json = el.querySelector('script[type="application/json"]')?.textContent;
        if (!json) continue;
        load().then((lottie) => {
          const anim = lottie.loadAnimation({ container: el, renderer: 'svg', loop: false, autoplay: false, animationData: JSON.parse(json), rendererSettings: { className: 'lottie-svg' } });
          anim.addEventListener('DOMLoaded', () => { el.classList.add('is-lottie'); anim.play(); });
          // Replays when a mouse moves onto the card (not on touch, where hover does not exist)
          el.closest<HTMLElement>('[data-lottie-card]')?.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') anim.goToAndPlay(0, true); });
        }).catch(() => { /* keep the static icon */ });
      }
    }, { rootMargin: '0px 0px -10% 0px' });
    icons.forEach((el) => io.observe(el));
  }
</script>
