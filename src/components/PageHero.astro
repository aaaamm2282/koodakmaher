---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Stroke from './Stroke.astro';
interface Props {
  title: string;
  subtitle?: string;
  crumbs?: { href?: string; label: string }[];
  /** A short status shown under the heading, such as «به‌زودی» */
  badge?: string;
  /** A short line that names the page's subject (often its search phrase), set beside the gold line under the
      heading. It replaces the old small label above the heading. */
  tagline?: string;
  /** A real photo of the place (with consent). Without it the hero stays text-only. */
  image?: { src: ImageMetadata; alt: string } | null;
}
const { title, subtitle, crumbs = [], badge, tagline, image } = Astro.props;
---
<section class="relative border-b border-line">
  <div class="container-x pt-6 pb-12 sm:pt-8 sm:pb-16">
    {crumbs.length > 0 && (
      <nav aria-label="مسیر صفحه" class="text-sm text-ink-mute">
        <ol class="flex flex-wrap items-center gap-x-2">
          <li><a href="/" class="inline-flex min-h-8 items-center transition-colors hover:text-ink">خانه</a></li>
          {crumbs.map((c) => (
            <li class="flex items-center gap-2"><span aria-hidden="true" class="text-line-strong">/</span>{c.href ? <a href={c.href} class="inline-flex min-h-8 items-center transition-colors hover:text-ink">{c.label}</a> : <span aria-current="page" class="text-ink-soft">{c.label}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    <div class:list={['mt-8 sm:mt-10', image ? 'grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-14' : 'max-w-3xl']}>
      <div class:list={[image && 'max-w-3xl']}>
        <h1 class="rise text-[2rem] sm:text-[2.5rem] md:text-[3rem]" style="--i:0; line-height:1.35">{title}</h1>
        <!-- The gold line, the site's one signature mark (the 3-to-18 path, the current page in the menu), drawn by
             hand under the heading from the reading side (Stroke.astro) -->
        {tagline
          ? <p class="mt-5 flex items-center gap-3 text-sm text-ink-mute"><Stroke class="h-2.5 w-16 shrink-0" delay="0.25s" /><span class="rise" style="--i:1">{tagline}</span></p>
          : <Stroke class="mt-5 h-2.5 w-16" delay="0.25s" />}
        {badge && <p class="rise mt-5" style="--i:1"><span class="chip">{badge}</span></p>}
        {subtitle && <p class="rise lead mt-5" style="--i:1">{subtitle}</p>}
        <slot />
      </div>
      {image && (
        <figure class="relative overflow-hidden rounded-2xl border border-line bg-sand">
          <!-- No entrance animation here: this photo is usually the largest paint (LCP) of the page -->
          <Picture src={image.src} alt={image.alt} formats={['avif', 'webp']} widths={[480, 720, 960, 1280]} sizes="(min-width: 1024px) 40vw, 100vw"
            loading="eager" fetchpriority="high" class="aspect-[4/3] h-full w-full object-cover" />
        </figure>
      )}
    </div>
  </div>
</section>
