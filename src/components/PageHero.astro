---
import Logo from './Logo.astro';
interface Props { title: string; subtitle?: string; kicker?: string; crumbs?: { href?: string; label: string }[]; badge?: string }
const { title, subtitle, kicker, crumbs = [], badge } = Astro.props;
---
<section class="relative overflow-hidden border-b border-line">
  <Logo variant="mark" class="page-logo pointer-events-none absolute top-1/2 left-[4%] hidden w-72 -translate-y-1/2 text-accent/[0.06] lg:block" />
  <div class="container-x relative pt-8 pb-12 sm:pt-10 sm:pb-16">
    {crumbs.length > 0 && (
      <nav aria-label="مسیر صفحه" class="text-sm text-ink-mute">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-ink">خانه</a></li>
          {crumbs.map((c) => (
            <li class="flex items-center gap-2"><span aria-hidden="true" class="text-line-strong">/</span>{c.href ? <a href={c.href} class="hover:text-ink">{c.label}</a> : <span aria-current="page" class="text-ink-soft">{c.label}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    <div class="mt-10 max-w-3xl">
      <div class="rise flex flex-wrap items-center gap-3" style="--i:0">
        {kicker && <p class="kicker">{kicker}</p>}
        {badge && <span class="rounded-md border border-saffron/30 bg-saffron-soft px-2 py-0.5 text-xs font-medium text-saffron">{badge}</span>}
      </div>
      <h1 class="rise mt-4 text-[2rem] sm:text-[2.5rem] md:text-[3rem]" style="--i:1; line-height:1.35">{title}</h1>
      {subtitle && <p class="rise lead mt-5" style="--i:2">{subtitle}</p>}
      <slot />
    </div>
  </div>
</section>
