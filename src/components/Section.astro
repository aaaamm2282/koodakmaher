---
interface Props { id?: string; title?: string; kicker?: string; intro?: string; class?: string; tone?: 'paper' | 'sand' | 'white' }
const { id, title, kicker, intro, class: cls = '', tone = 'paper' } = Astro.props;
const hid = id ? `${id}-title` : undefined;
---
<section id={id} class:list={['scroll-mt-24', tone === 'sand' && 'bg-sand', tone === 'white' && 'border-y border-line bg-surface']} aria-labelledby={title ? hid : undefined}>
  <div class:list={['container-x py-16 sm:py-24', cls]}>
    {(title || kicker) && (
      <div class="max-w-2xl" data-reveal>
        {kicker && <p class="kicker">{kicker}</p>}
        {title && <h2 id={hid} class="section-title mt-3">{title}</h2>}
        {intro && <p class="lead mt-4">{intro}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
