---
// Cards that settle on top of each other while the page scrolls (after "Sticky Services Stack" and "Stacking card"
// on 21st.dev, docs/21st-elements.md). Each card sticks a little lower than the one before, so the cards behind
// show a strip like a deck; fx.ts makes a covered card sink and fade. Reduced motion: a plain list (global.css).
//   numbered = the steps have an order (the method's cycle): a numeral instead of the gold mark
//   on      = the colour of the section behind, which a covered card fades toward
interface Props { items: { t: string; d: string }[]; numbered?: boolean; on?: 'paper' | 'white' }
const { items, numbered = false, on = 'paper' } = Astro.props;
const List = numbered ? 'ol' : 'ul';
---
<List class="stack" role="list" data-stack style={on === 'white' ? '--stack-bg: var(--color-surface)' : undefined}>
  {items.map((p, i) => (
    <li class="stack-item" style={`--k:${i}`} data-stack-item>
      <div class:list={['stack-card flex min-h-[13rem] flex-col rounded-2xl border border-line p-7 sm:min-h-[15rem] sm:p-10', on === 'white' ? 'bg-paper' : 'bg-surface']} data-stack-card>
        {numbered
          ? <span class="num block text-[2.75rem] leading-none text-saffron">{(i + 1).toLocaleString('fa-IR')}</span>
          : <span class="block h-0.5 w-10 rounded-full bg-gold" aria-hidden="true"></span>}
        <div class="mt-auto pt-8">
          <h3 class="text-2xl">{p.t}</h3>
          <p class="mt-3 max-w-xl text-ink-soft sm:text-lg" style="line-height:1.9">{p.d}</p>
        </div>
        <span class="stack-veil" aria-hidden="true" data-stack-veil></span>
      </div>
    </li>
  ))}
</List>
