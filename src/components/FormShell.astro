---
import Icon from './Icon.astro';
// Forms are appearance-only for now: the institute will choose where submissions go.
// No endpoint, key or secret lives in the code. When a destination is chosen, pass it as `action`.
interface Props { title?: string; submit: string; action?: string; id: string; kind?: string }
const { title, submit, action = '', id, kind = id } = Astro.props;
---
<form id={id} class="card p-6 shadow-soft sm:p-8" method="post" action={action || undefined} data-form data-kind={kind} data-action={action} novalidate>
  {title && <h2 class="mb-6 text-2xl">{title}</h2>}
  <div class="grid gap-5 sm:grid-cols-2" data-fields>
    <slot />
  </div>
  <p class="mt-4 text-sm text-ink-soft"><span class="text-danger">*</span> پر کردن این موارد لازم است.</p>
  <p class="form-error mt-3 hidden rounded-lg border border-danger/25 bg-danger/5 p-3 text-sm text-danger" role="alert"></p>
  <button type="submit" class="btn-primary mt-6 w-full">{submit}<Icon name="send" size={20} /></button>
  <div class="form-notice mt-4 hidden rounded-lg border border-accent/25 bg-accent-soft p-4 text-center" role="status" aria-live="polite">
    <p class="font-medium">فرم درست پر شده است.</p>
    <p class="mt-1 text-sm text-ink-soft">ارسال فرم‌ها هنوز راه‌اندازی نشده، پس اطلاعات شما فرستاده نشد. به‌زودی این امکان فعال می‌شود.</p>
  </div>
</form>

<script>
  const fa = '۰۱۲۳۴۵۶۷۸۹';
  document.querySelectorAll<HTMLFormElement>('form[data-form]').forEach((form) => {
    const err = form.querySelector<HTMLElement>('.form-error')!;
    const notice = form.querySelector<HTMLElement>('.form-notice')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      form.querySelectorAll<HTMLInputElement>('input[type=tel]').forEach((i) => (i.value = i.value.replace(/[۰-۹]/g, (d) => String(fa.indexOf(d)))));
      form.querySelectorAll<HTMLElement>('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      form.querySelectorAll<HTMLElement>('.field-error').forEach((p) => { p.textContent = ''; p.classList.add('hidden'); });
      form.querySelectorAll<HTMLTextAreaElement>('textarea[data-maxwords]').forEach((t) => {
        const max = Number(t.dataset.maxwords);
        const words = t.value.trim().split(/\s+/).filter(Boolean).length;
        t.setCustomValidity(words > max ? `متن بیش از ${max.toLocaleString('fa-IR')} کلمه است؛ کوتاه‌ترش کنید.` : '');
      });
      const bad = [...form.querySelectorAll<HTMLInputElement>('input,select,textarea')].filter((el) => !el.checkValidity());
      if (bad.length) {
        // Errors sit next to each field (Vercel Web Interface Guidelines); focus the first one.
        bad.forEach((el) => {
          el.setAttribute('aria-invalid', 'true');
          const p = document.getElementById(`${el.id}-err`);
          const text = el.validity.customError ? el.validationMessage
            : el.validity.valueMissing ? (el.type === 'checkbox' ? 'برای ادامه، این گزینه را تأیید کنید.' : 'این مورد را پر کنید.')
            : el.validity.typeMismatch || el.validity.patternMismatch ? 'قالب واردشده درست نیست؛ دوباره بررسی کنید.'
            : 'این مورد را بررسی کنید.';
          if (p) { p.textContent = text; p.classList.remove('hidden'); el.setAttribute('aria-describedby', [el.getAttribute('aria-describedby'), p.id].filter(Boolean).join(' ')); }
        });
        err.textContent = `${bad.length.toLocaleString('fa-IR')} مورد نیاز به اصلاح دارد.`;
        err.classList.remove('hidden');
        bad[0].focus();
                return;
      }
      err.classList.add('hidden');
      const action = form.dataset.action;
      if (action) {
        try {
          const res = await fetch(action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error();
          notice.innerHTML = '<p class="font-medium">درخواست شما ثبت شد.</p><p class="mt-1 text-sm">همکاران ما با شما تماس می‌گیرند.</p>';
        } catch {
          err.textContent = 'ارسال انجام نشد. لطفاً دوباره تلاش کنید.';
          err.classList.remove('hidden');
          return;
        }
      }
      notice.classList.remove('hidden');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) notice.animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 300, easing: 'cubic-bezier(.23,1,.32,1)' });
    });
  });
</script>
