---
import { cycle } from '../data/site';
interface Props { items?: { title: string; text: string }[] }
const { items } = Astro.props;
const steps = cycle.map((c, i) => ({ ...c, ...(items?.[i] ?? {}) }));
---
<ol class="grid border-t border-line md:grid-cols-3" data-stagger>
  {steps.map((s, i) => (
    <li class:list={['relative py-8 md:px-8 md:py-10', i > 0 && 'border-t border-line md:border-t-0 md:border-r', i === 0 && 'md:pr-0', i === steps.length - 1 && 'md:pl-0']}>
      <span class="num block text-[2.75rem] leading-none text-saffron">{(i + 1).toLocaleString('fa-IR')}</span>
      <h3 class="mt-5 text-2xl">{s.title}</h3>
      <p class="mt-3 text-ink-soft">{s.text}</p>
    </li>
  ))}
</ol>
