---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { nav, site, units } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header id="site-header" class="sticky top-0 z-50 border-b border-transparent bg-paper/95 transition-[border-color] duration-200 data-[scrolled=true]:border-line">
  <div class="container-x flex h-16 items-center justify-between gap-6 lg:h-[4.5rem]">
    <a href="/" class="flex items-center gap-3">
      <Logo class="h-10 w-10 shrink-0" decorative />
      <span class="flex flex-col leading-tight">
        <span class="font-serif text-[1.0625rem] font-semibold">{site.brand}</span>
        <span class="text-xs text-ink-mute">مؤسسه آموزشی کودک ماهر مانا</span>
      </span>
      <span class="sr-only">، صفحه اول</span>
    </a>

    <nav aria-label="منوی اصلی" class="hidden xl:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => item.children ? (
          <li class="group relative">
            <a href={item.href} class:list={['flex items-center gap-1 px-3 py-2 text-[0.9375rem] transition-colors hover:text-ink', isActive(item.href) ? 'text-ink font-medium' : 'text-ink-soft']} aria-haspopup="true">
              {item.label}<Icon name="chevron" size={15} class="transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" />
            </a>
            <div class="invisible absolute top-full right-0 pt-2 opacity-0 transition-[opacity,visibility] duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <ul class="w-72 rounded-xl border border-line bg-surface p-1.5 shadow-soft">
                {units.map((u) => (
                  <li>
                    <a href={`/units/${u.slug}/`} class="flex items-center justify-between gap-2 rounded-lg px-3 py-2.5 text-[0.9375rem] hover:bg-sand">
                      <span>{u.name}</span>
                      {u.soon ? <span class="text-xs text-ink-mute">به‌زودی</span> : u.ages && <span class="truncate text-xs text-ink-mute">{u.ages.split('،')[0]}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ) : (
          <li>
            <a href={item.href} class:list={['relative block px-3 py-2 text-[0.9375rem] transition-colors hover:text-ink', isActive(item.href) ? 'text-ink font-medium after:absolute after:inset-x-3 after:-bottom-[0.95rem] after:h-0.5 after:bg-gold' : 'text-ink-soft after:absolute after:inset-x-3 after:bottom-0.5 after:h-px after:origin-right after:scale-x-0 after:bg-accent after:transition-transform after:duration-300 hover:after:scale-x-100']} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/register/" class="btn-primary hidden !min-h-10 !px-4 text-sm sm:inline-flex" data-cta="header">پیش‌ثبت‌نام و مشاوره</a>
      <button id="menu-btn" type="button" class="grid h-11 w-11 place-items-center rounded-lg border border-line bg-surface xl:hidden" aria-label="باز کردن منو" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="pointer-events-none fixed inset-0 z-50 opacity-0 transition-opacity duration-200 xl:hidden data-[open=true]:pointer-events-auto data-[open=true]:opacity-100" data-open="false">
    <div class="absolute inset-0 bg-ink/30" data-close></div>
    <nav aria-label="منوی موبایل" class="absolute inset-y-0 right-0 flex w-[min(22rem,88vw)] flex-col overflow-y-auto overscroll-contain bg-paper p-5 shadow-soft">
      <div class="mb-4 flex items-center justify-between">
        <span class="font-serif text-lg font-semibold">منو</span>
        <button type="button" class="grid h-11 w-11 place-items-center rounded-lg border border-line bg-surface" aria-label="بستن منو" data-close>
          <Icon name="close" size={22} />
        </button>
      </div>
      <ul class="divide-y divide-line border-y border-line">
        {nav.map((item) => (
          <li>
            <a href={item.href} class:list={['block py-3 text-[1.0625rem]', isActive(item.href) && 'font-medium text-accent']} data-close>{item.label}</a>
            {item.children && (
              <ul class="mb-3 space-y-0.5 border-r border-line pr-3">
                {units.map((u) => <li><a href={`/units/${u.slug}/`} class="block py-1.5 text-ink-soft" data-close>{u.name}{u.soon && ' (به‌زودی)'}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <a href="/register/" class="btn-primary mt-5 w-full" data-close data-cta="menu">پیش‌ثبت‌نام و مشاوره</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const onScroll = () => (header.dataset.scrolled = String(window.scrollY > 8));
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const menu = document.getElementById('mobile-menu')!;
  const btn = document.getElementById('menu-btn')!;
  const setOpen = (open: boolean) => {
    menu.dataset.open = String(open);
    btn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (!open && menu.contains(document.activeElement)) btn.focus();
  };
  btn.addEventListener('click', () => setOpen(true));
  menu.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && menu.dataset.open === 'true' && setOpen(false));
</script>
