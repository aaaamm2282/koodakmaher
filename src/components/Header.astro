---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
---
<header id="site-header" class="sticky top-0 z-50 transition-all duration-300 data-[scrolled=true]:bg-cream/85 data-[scrolled=true]:shadow-[0_1px_0_rgb(31_26_61/0.08)] data-[scrolled=true]:backdrop-blur-md">
  <div class="container-x flex h-18 items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${site.name} - صفحه اصلی`}>
      <Logo class="h-11 w-11" />
      <span class="flex flex-col leading-tight">
        <span class="text-lg font-black">{site.brand}</span>
        <span class="text-xs font-medium text-ink-soft">کودکستان و پیش‌دبستانی</span>
      </span>
    </a>

    <nav aria-label="منوی اصلی" class="hidden lg:block">
      <ul class="flex items-center gap-1 rounded-full bg-white/70 p-1.5 ring-1 ring-ink/5 backdrop-blur">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="block rounded-full px-4 py-2 text-sm font-bold text-ink-soft transition-colors hover:bg-sun-soft hover:text-ink">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/#register" class="btn-primary shimmer hidden !min-h-11 !px-5 text-sm sm:inline-flex">ثبت‌نام</a>
      <button id="menu-btn" type="button" class="grid h-11 w-11 place-items-center rounded-full bg-white ring-1 ring-ink/10 lg:hidden" aria-label="باز کردن منو" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="pointer-events-none fixed inset-0 z-50 opacity-0 transition-opacity duration-300 lg:hidden data-[open=true]:pointer-events-auto data-[open=true]:opacity-100" data-open="false">
    <div class="absolute inset-0 bg-ink/40 backdrop-blur-sm" data-close></div>
    <nav aria-label="منوی موبایل" class="absolute inset-x-3 top-3 rounded-[2rem] bg-cream p-5 shadow-2xl">
      <div class="mb-4 flex items-center justify-between">
        <span class="font-black">منو</span>
        <button type="button" class="grid h-11 w-11 place-items-center rounded-full bg-white ring-1 ring-ink/10" aria-label="بستن منو" data-close>
          <Icon name="close" />
        </button>
      </div>
      <ul class="space-y-1">
        {nav.map((item) => (
          <li><a href={item.href} class="block rounded-2xl px-4 py-3 text-lg font-bold hover:bg-sun-soft" data-close>{item.label}</a></li>
        ))}
      </ul>
      <a href="/#register" class="btn-primary mt-4 w-full" data-close>درخواست ثبت‌نام</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const onScroll = () => header.dataset.scrolled = String(window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const menu = document.getElementById('mobile-menu')!;
  const btn = document.getElementById('menu-btn')!;
  const setOpen = (open: boolean) => {
    menu.dataset.open = String(open);
    btn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  btn.addEventListener('click', () => setOpen(true));
  menu.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
