---
import Icon from './Icon.astro';
interface Props { title?: string; text?: string; button?: string; href?: string }
const {
  title = 'برای آشنایی بیشتر، یک جلسه مشاوره رزرو کنید',
  text = 'در این جلسه برنامه، فضا و رویکرد ما را از نزدیک می‌بینید و پرسش‌هایتان را می‌پرسید.',
  button = 'پیش‌ثبت‌نام و مشاوره',
  href = '/register/',
} = Astro.props;
---
<section class="container-x py-16 sm:py-20" aria-labelledby="cta-title">
  <div class="grid gap-8 border-t border-ink pt-10 md:grid-cols-[1fr_auto] md:items-end" data-reveal>
    <div class="max-w-2xl">
      <h2 id="cta-title" class="text-[1.625rem] sm:text-[2rem]">{title}</h2>
      <p class="lead mt-3">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={href} class="btn-primary">{button}<Icon name="arrow" size={18} /></a>
      <a href="/contact/" class="btn-ghost">تماس با مراکز</a>
    </div>
  </div>
</section>
