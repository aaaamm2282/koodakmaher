---
// The page's closing panel: a sheet of navy paper with the hills of the home hero along its foot, so the last step is
// never lost in the text above it. One main action (white) and one quieter one.
import Art from './Art.astro';
import Icon from './Icon.astro';
import Stroke from './Stroke.astro';
interface Props { title?: string; text?: string; button?: string; href?: string }
const {
  title = 'برای آشنایی بیشتر، یک جلسه مشاوره رزرو کنید',
  text = 'در این جلسه برنامه، فضا و رویکرد ما را از نزدیک می‌بینید و پرسش‌هایتان را می‌پرسید.',
  button = 'پیش‌ثبت‌نام و مشاوره',
  href = '/register/',
} = Astro.props;
---
<section class="cta-band container-x py-16 sm:py-24" aria-labelledby="cta-title">
  <div class="relative isolate overflow-clip rounded-[1.75rem] bg-accent text-white shadow-[var(--shadow-paper)]">
    <div class="px-6 pt-10 pb-28 sm:px-12 sm:pt-14 sm:pb-36 lg:pb-44">
      <div class="max-w-3xl">
        <h2 id="cta-title" class="text-title text-white sm:text-[2.25rem]" style="line-height:1.45">{title}</h2>
        <Stroke class="mt-5 h-2.5 w-16" still />
        <p class="mt-5 text-md text-white/85 sm:text-lg" style="line-height:1.9">{text}</p>
      </div>
      <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap">
        <a href={href} class="btn-light" data-cta="page-end">{button}<Icon name="arrow" size={18} /></a>
        <a href="/contact/" class="btn-ghost-light">تماس با مراکز</a>
      </div>
    </div>
    <Art name="hills" class="hills absolute inset-x-0 bottom-0 -z-10" />
  </div>
</section>
