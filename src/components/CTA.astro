---
// The page's closing panel. The one navy block a reader meets at the end of a page, so the last step is never
// lost in the text above it: one main action (white) and one quieter one.
import Icon from './Icon.astro';
import Stroke from './Stroke.astro';
interface Props { title?: string; text?: string; button?: string; href?: string }
const {
  title = 'برای آشنایی بیشتر، یک جلسه مشاوره رزرو کنید',
  text = 'در این جلسه برنامه، فضا و رویکرد ما را از نزدیک می‌بینید و پرسش‌هایتان را می‌پرسید.',
  button = 'پیش‌ثبت‌نام و مشاوره',
  href = '/register/',
} = Astro.props;
---
<section class="cta-band container-x py-16 sm:py-24" aria-labelledby="cta-title">
  <!-- Stacked like a page heading (heading, gold line, text, actions), so the heading keeps one line on wide screens -->
  <!-- The outer box stands up from a slight backward lean as it scrolls into view (.cta-tilt, CSS only) -->
  <div class="cta-tilt">
  <div class="rounded-2xl bg-accent px-6 py-10 text-white sm:px-12 sm:py-14" data-reveal>
    <div class="max-w-3xl">
      <h2 id="cta-title" class="text-title text-white sm:text-[2.25rem]" style="line-height:1.45">{title}</h2>
      <Stroke class="mt-5 h-2.5 w-16" view delay="0.35s" />
      <p class="mt-5 text-md text-white/80 sm:text-lg" style="line-height:1.9">{text}</p>
    </div>
    <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap">
      <a href={href} class="btn-light focus-visible:outline-white" data-cta="page-end" data-magnetic>{button}<Icon name="arrow" size={18} /></a>
      <a href="/contact/" class="btn-ghost-light focus-visible:outline-white">تماس با مراکز</a>
    </div>
  </div>
  </div>
</section>
