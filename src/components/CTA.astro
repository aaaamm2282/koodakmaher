---
import Icon from './Icon.astro';
interface Props { title?: string; text?: string; button?: string; href?: string }
const {
  title = 'برای آشنایی بیشتر، یک جلسه مشاوره رزرو کنید',
  text = 'در این جلسه برنامه، فضا و رویکرد ما را از نزدیک می‌بینید و پرسش‌هایتان را می‌پرسید.',
  button = 'پیش‌ثبت‌نام و مشاوره',
  href = '/register/',
} = Astro.props;
---
<section class="container-x py-16" aria-label="فراخوان پیش‌ثبت‌نام">
  <div class="relative overflow-hidden rounded-[2.5rem] bg-sun p-8 sm:p-12 md:p-14" data-reveal="scale">
    <div class="pointer-events-none absolute -top-16 -left-16 h-56 w-56 rounded-full bg-coral/30" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-20 left-1/3 h-48 w-48 rounded-full border-[16px] border-white/40 spin-slow" aria-hidden="true"></div>
    <div class="relative flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-black sm:text-3xl md:text-4xl">{title}</h2>
        <p class="mt-3 text-lg text-ink/80">{text}</p>
      </div>
      <a href={href} class="btn-primary shimmer shrink-0 text-lg" data-magnetic>{button}<Icon name="arrow" size={20} /></a>
    </div>
  </div>
</section>
