---
// A hand-drawn gold stroke (after "Annotated Text" on 21st.dev, docs/21st-elements.md): a brush mark that is
// thicker in the middle, lifts a little at its end, and is revealed in reading direction, right to left.
// The site's signature gold line, drawn by hand instead of ruled.
//   view  = drawn when it comes into view (reveal.ts), instead of on page load
//   delay = when it starts after the page or the view, e.g. "0.8s"
interface Props { class?: string; view?: boolean; delay?: string }
const { class: cls, view = false, delay } = Astro.props;
---
<svg class:list={['stroke-draw', cls]} viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true" focusable="false"
  data-inview={view ? '' : undefined} style={delay ? `--delay:${delay}` : undefined}>
  <path fill="currentColor" d="M198.6 5.4C176 4.3 150 3.7 122 3.9 92 4.1 61 4.6 34 4.1 21 3.9 10 3.2 1.6 1.9 0.6 1.8 0.2 3 1.1 3.5 9.8 6.3 22 7.6 36 8.1 62 8.9 92 8.2 121 7.9 149 7.7 175 8.3 197.9 8.6 199.7 8.6 200.3 5.5 198.6 5.4Z" />
</svg>
