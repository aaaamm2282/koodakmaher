---
// Questions and answers as native <details> (keyboard and screen-reader friendly without JS).
import Pending from './Pending.astro';
import Icon from './Icon.astro';
interface Props { items: { q: string; a?: string | null; pending?: string | null }[]; level?: 'h2' | 'h3'; openFirst?: boolean; class?: string }
const { items, level = 'h2', openFirst = true, class: cls = '' } = Astro.props;
const H = level;
---
<div class:list={['border-t border-line', cls]} data-stagger>
  {items.map((f, i) => (
    <details class="group border-b border-line" open={openFirst && i === 0}>
      <summary class="flex min-h-11 cursor-pointer list-none items-start justify-between gap-6 py-5 transition-colors hover:text-accent [&::-webkit-details-marker]:hidden">
        <H class="text-lg sm:text-xl">{f.q}</H>
        <Icon name="plus" size={20} class="mt-1.5 shrink-0 text-ink-mute transition-transform duration-200 group-open:rotate-45" />
      </summary>
      <div class="space-y-3 pb-6 text-ink-soft">
        {f.a && <p class="leading-[1.95]">{f.a}</p>}
        {f.pending && <Pending inline label={f.pending} />}
      </div>
    </details>
  ))}
</div>
