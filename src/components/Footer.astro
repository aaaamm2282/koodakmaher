---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Pending from './Pending.astro';
import { footerLinks, site, social, units } from '../data/site';
const places = units.filter((u) => u.address);
---
<footer class="bg-forest text-white/80">
  <div class="container-x grid gap-12 py-16 md:grid-cols-12">
    <div class="md:col-span-4">
      <a href="/" class="flex items-center gap-3 text-white">
        <Logo class="h-10 w-10" light />
        <span class="font-serif text-lg font-semibold">{site.name}</span>
      </a>
      <p class="mt-5 font-serif text-lg text-white">{site.slogan}</p>
      <p class="mt-3 max-w-sm text-sm leading-7 text-white/65">{site.mission}</p>
    </div>

    <div class="md:col-span-5">
      <h2 class="font-sans text-sm font-medium text-white">نشانی مراکز</h2>
      <ul class="mt-4 space-y-4 text-sm leading-7">
        {places.map((u) => (
          <li>
            <a href={`/units/${u.slug}/`} class="font-medium text-white hover:underline">{u.name}</a>
            <p class="text-white/65">{u.address}</p>
            {u.phone && <a href={`tel:${u.phone.tel}`} class="num text-white/80 hover:text-white" dir="ltr">{u.phone.display}</a>}
          </li>
        ))}
      </ul>
    </div>

    <div class="grid grid-cols-2 gap-8 md:col-span-3 md:grid-cols-1">
      <nav aria-label="پیوندهای سریع">
        <h2 class="font-sans text-sm font-medium text-white">دسترسی سریع</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {footerLinks.map((i) => <li><a class="hover:text-white" href={i.href}>{i.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2 class="font-sans text-sm font-medium text-white">ما را دنبال کنید</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {social.slice(4).map((s) => <li><a href={s.href} class="hover:text-white" rel="noopener" target="_blank">{s.label}</a></li>)}
          <li><a href="/contact/#social" class="hover:text-white">صفحه‌های اینستاگرام</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-3 py-5 text-xs text-white/55 sm:flex-row sm:items-center sm:justify-between">
      <p>© {site.name}، از سال <span class="num">{site.foundingYear}</span></p>
      <p class="flex items-center gap-2"><Icon name="shield" size={16} /><Pending inline label="نماد اعتماد و مجوزها" tone="dark" /></p>
    </div>
  </div>
</footer>
