---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site } from '../data/site';
const words1 = 'یادگیری برای زندگی،'.split(' ');
---
<section class="relative isolate overflow-hidden pt-8 pb-20 sm:pt-14 md:pb-28" aria-labelledby="hero-title">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-32 -left-24 h-96 w-96 rounded-full bg-sky-soft blur-3xl"></div>
    <div class="absolute top-40 -right-24 h-80 w-80 rounded-full bg-sun-soft blur-3xl"></div>
    <div class="absolute bottom-0 left-1/3 h-72 w-72 rounded-full bg-coral-soft blur-3xl"></div>
    <svg class="absolute inset-0 h-full w-full opacity-[0.35]" aria-hidden="true">
      <defs><pattern id="dots" width="28" height="28" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.5" fill="#1f1a3d" opacity=".18" /></pattern></defs>
      <rect width="100%" height="100%" fill="url(#dots)" />
    </svg>
  </div>

  <div class="container-x grid items-center gap-14 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <p class="hero-word" style="--i:0"><span class="eyebrow">{site.name}</span></p>
      <h1 id="hero-title" class="mt-6 text-4xl font-black sm:text-5xl lg:text-6xl">
        {words1.map((w, i) => <span class="hero-word inline-block" style={`--i:${i + 1}`}>{w}&nbsp;</span>)}
        <br />
        <span class="hero-word squiggle text-gradient inline-block" style="--i:4">
          نه برای امتحان
          <svg viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true"><path d="M3 14 Q 40 2 75 12 T 150 12 T 225 12 T 297 8" fill="none" stroke="#ffc93c" stroke-width="7" stroke-linecap="round" /></svg>
        </span>
      </h1>
      <p class="hero-word mt-8 max-w-xl text-lg text-ink-soft sm:text-xl" style="--i:6">
        از کودکستان تا نوجوانی، کنار فرزندتان هستیم تا خودش را بشناسد، با تجربه واقعی یاد بگیرد و مسیرش را آگاهانه انتخاب کند.
      </p>
      <div class="hero-word mt-8 flex flex-wrap gap-3" style="--i:7">
        <a href="/register/" class="btn-primary shimmer text-lg" data-magnetic>پیش‌ثبت‌نام و مشاوره<Icon name="arrow" size={20} /></a>
        <a href="/method/" class="btn-ghost text-lg">متد کودک ماهر چیست؟</a>
      </div>
    </div>

    <!-- Illustration of the method cycle: predict → experience → review -->
    <div class="relative mx-auto aspect-square w-full max-w-[500px]" aria-hidden="true">
      <div class="absolute inset-[10%] rounded-[38%_62%_55%_45%/45%_40%_60%_55%] bg-sun" style="animation: float 12s ease-in-out infinite"></div>
      <svg viewBox="0 0 400 400" class="absolute inset-0 h-full w-full">
        <defs>
          <marker id="arr" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" fill="#1f1a3d" /></marker>
        </defs>
        <g class="spin-slow" style="transform-origin:200px 200px; animation-duration:40s">
          <circle cx="200" cy="200" r="128" fill="none" stroke="#1f1a3d" stroke-width="4" stroke-dasharray="10 14" stroke-linecap="round" opacity=".55" />
        </g>
        <g fill="none" stroke="#1f1a3d" stroke-width="5" stroke-linecap="round" marker-end="url(#arr)" class="cycle-arrows">
          <path d="M232 82a128 128 0 0 1 92 110" pathLength="1" />
          <path d="M300 290a128 128 0 0 1-180 12" pathLength="1" />
          <path d="M84 250a128 128 0 0 1 64-166" pathLength="1" />
        </g>
      </svg>
      <div class="absolute top-1/2 left-1/2 grid h-[30%] w-[30%] -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white ring-4 ring-ink shadow-[0_8px_0_#1f1a3d]">
        <Logo class="h-[70%] w-[70%]" />
      </div>
      <div class="float-a absolute top-[2%] left-1/2 -translate-x-1/2" data-parallax="70">
        <div class="flex items-center gap-2 rounded-2xl bg-white px-4 py-2.5 font-black ring-4 ring-ink shadow-[0_6px_0_#1f1a3d]"><span class="grid h-9 w-9 place-items-center rounded-xl bg-sun"><Icon name="sparkle" size={20} /></span>پیش‌بینی</div>
      </div>
      <div class="float-b absolute right-[-2%] bottom-[16%]" data-parallax="110">
        <div class="flex items-center gap-2 rounded-2xl bg-white px-4 py-2.5 font-black ring-4 ring-ink shadow-[0_6px_0_#1f1a3d]"><span class="grid h-9 w-9 place-items-center rounded-xl bg-coral text-white"><Icon name="hand" size={20} /></span>تجربه</div>
      </div>
      <div class="float-c absolute bottom-[16%] left-[-2%]" data-parallax="90">
        <div class="flex items-center gap-2 rounded-2xl bg-white px-4 py-2.5 font-black ring-4 ring-ink shadow-[0_6px_0_#1f1a3d]"><span class="grid h-9 w-9 place-items-center rounded-xl bg-sky text-white"><Icon name="refresh" size={20} /></span>بازبینی</div>
      </div>
      <div class="float-b absolute top-[18%] left-[4%] hidden sm:grid h-14 w-14 place-items-center rounded-2xl bg-mint text-xl font-black text-white ring-4 ring-ink shadow-[0_6px_0_#1f1a3d]" data-parallax="130">۳</div>
      <div class="float-a absolute top-[18%] right-[4%] hidden sm:grid h-14 w-14 place-items-center rounded-2xl bg-grape text-xl font-black text-white ring-4 ring-ink shadow-[0_6px_0_#1f1a3d]" data-parallax="150">۱۸</div>
    </div>
  </div>
</section>
