---
import Icon from './Icon.astro';
import { site } from '../data/site';
const line1 = 'کودکستان کودک ماهر؛'.split(' ');
const line2 = 'جایی که بازی'.split(' ');
---
<section class="relative isolate overflow-hidden pt-8 pb-20 sm:pt-14 md:pb-28" aria-labelledby="hero-title">
  <!-- soft background blobs -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-32 -left-24 h-96 w-96 rounded-full bg-sky-soft blur-3xl"></div>
    <div class="absolute top-40 -right-24 h-80 w-80 rounded-full bg-sun-soft blur-3xl"></div>
    <div class="absolute bottom-0 left-1/3 h-72 w-72 rounded-full bg-coral-soft blur-3xl"></div>
    <svg class="absolute inset-0 h-full w-full opacity-[0.35]" aria-hidden="true">
      <defs><pattern id="dots" width="28" height="28" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.5" fill="#1f1a3d" opacity=".18" /></pattern></defs>
      <rect width="100%" height="100%" fill="url(#dots)" />
    </svg>
  </div>

  <div class="container-x grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <p class="eyebrow hero-word" style="--i:0">
        <span class="relative flex h-2.5 w-2.5"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-mint opacity-75"></span><span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-mint"></span></span>
        ثبت‌نام سال تحصیلی جدید آغاز شد
      </p>
      <h1 id="hero-title" class="mt-6 text-4xl font-black sm:text-5xl lg:text-6xl">
        {line1.map((w, i) => <span class="hero-word inline-block" style={`--i:${i + 1}`}>{w}&nbsp;</span>)}
        <br />
        {line2.map((w, i) => <span class="hero-word inline-block" style={`--i:${i + 3}`}>{w}&nbsp;</span>)}
        <span class="hero-word squiggle text-gradient inline-block" style="--i:6">
          مهارت می‌شود
          <svg viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true"><path d="M3 14 Q 40 2 75 12 T 150 12 T 225 12 T 297 8" fill="none" stroke="#ffc93c" stroke-width="7" stroke-linecap="round" /></svg>
        </span>
      </h1>
      <p class="hero-word mt-8 max-w-xl text-lg text-ink-soft sm:text-xl" style="--i:8">
        آموزش مهارت‌محور برای کودکان {site.ageRange.min.toLocaleString('fa-IR')} تا {site.ageRange.max.toLocaleString('fa-IR')} سال؛ با بازی، قصه، هنر، علوم و زبان انگلیسی، در محیطی امن و شاد که کودک را برای مدرسه و زندگی آماده می‌کند.
      </p>
      <div class="hero-word mt-8 flex flex-wrap gap-3" style="--i:9">
        <a href="#register" class="btn-primary shimmer text-lg" data-magnetic>
          رزرو بازدید رایگان
          <Icon name="arrow" size={20} />
        </a>
        <a href="#programs" class="btn-ghost text-lg">آشنایی با دوره‌ها</a>
      </div>
      <ul class="hero-word mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm font-bold text-ink-soft" style="--i:10">
        <li class="flex items-center gap-1.5"><span class="grid h-6 w-6 place-items-center rounded-full bg-mint-soft text-mint"><Icon name="check" size={14} /></span>کلاس‌های حداکثر ۱۲ نفره</li>
        <li class="flex items-center gap-1.5"><span class="grid h-6 w-6 place-items-center rounded-full bg-sky-soft text-sky"><Icon name="check" size={14} /></span>مربیان متخصص رشد کودک</li>
        <li class="flex items-center gap-1.5"><span class="grid h-6 w-6 place-items-center rounded-full bg-coral-soft text-coral"><Icon name="check" size={14} /></span>تغذیه‌ی سالم و سرویس</li>
      </ul>
    </div>

    <!-- Illustrated playground composition (no stock photos needed) -->
    <div class="relative mx-auto aspect-square w-full max-w-[520px]" aria-hidden="true">
      <div class="absolute inset-[6%] rounded-[38%_62%_55%_45%/45%_40%_60%_55%] bg-sun" style="animation: float 12s ease-in-out infinite"></div>
      <svg viewBox="0 0 400 400" class="absolute inset-0 h-full w-full">
        <!-- rainbow -->
        <g fill="none" stroke-linecap="round" stroke-width="22" class="rainbow">
          <path d="M70 250a130 130 0 0 1 260 0" pathLength="1" stroke="#ff6b6b" />
          <path d="M98 250a102 102 0 0 1 204 0" pathLength="1" stroke="#4d96ff" />
          <path d="M126 250a74 74 0 0 1 148 0" pathLength="1" stroke="#2ec4b6" />
        </g>
        <!-- clouds -->
        <g fill="#fff">
          <ellipse cx="78" cy="252" rx="46" ry="26" /><ellipse cx="110" cy="244" rx="30" ry="24" />
          <ellipse cx="322" cy="252" rx="46" ry="26" /><ellipse cx="292" cy="244" rx="30" ry="24" />
        </g>
        <!-- house / school -->
        <g transform="translate(150 255)">
          <rect x="0" y="20" width="100" height="80" rx="10" fill="#fff" stroke="#1f1a3d" stroke-width="5" />
          <path d="M-10 26 50 -20 110 26" fill="#9b5de5" stroke="#1f1a3d" stroke-width="5" stroke-linejoin="round" />
          <rect x="38" y="58" width="24" height="42" rx="6" fill="#ffc93c" stroke="#1f1a3d" stroke-width="5" />
          <circle cx="22" cy="46" r="9" fill="#4d96ff" stroke="#1f1a3d" stroke-width="4" />
          <circle cx="78" cy="46" r="9" fill="#4d96ff" stroke="#1f1a3d" stroke-width="4" />
        </g>
      </svg>

      <!-- floating blocks -->
      <div class="float-a absolute top-[4%] right-[8%] grid h-20 w-20 place-items-center rounded-2xl bg-coral text-3xl font-black text-white shadow-[0_6px_0_#1f1a3d] ring-4 ring-ink" data-parallax="80">الف</div>
      <div class="float-b absolute top-[16%] left-[2%] grid h-16 w-16 place-items-center rounded-2xl bg-sky text-2xl font-black text-white shadow-[0_6px_0_#1f1a3d] ring-4 ring-ink" data-parallax="120" dir="ltr">A</div>
      <div class="float-c absolute bottom-[6%] left-[10%] grid h-16 w-16 place-items-center rounded-2xl bg-mint text-2xl font-black text-white shadow-[0_6px_0_#1f1a3d] ring-4 ring-ink" data-parallax="60">۱۲۳</div>
      <div class="float-a absolute right-[2%] bottom-[18%] grid h-14 w-14 place-items-center rounded-full bg-grape text-white shadow-[0_6px_0_#1f1a3d] ring-4 ring-ink" data-parallax="100"><Icon name="star" size={26} /></div>

      <!-- floating badge -->
      <div class="card absolute -bottom-4 left-[18%] flex items-center gap-3 px-4 py-3 float-b sm:left-[24%]">
        <span class="grid h-10 w-10 place-items-center rounded-full bg-sun-soft text-ink"><Icon name="heart" size={20} /></span>
        <span class="text-sm leading-tight"><b class="block">یادگیری با بازی</b><span class="text-ink-soft">برنامه‌ی روزانه‌ی شاد</span></span>
      </div>
    </div>
  </div>
</section>
