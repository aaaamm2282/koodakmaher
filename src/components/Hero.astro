---
import { Picture, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site, units } from '../data/site';
import { resolveImage } from '../lib/images';
// Real photo or short video of the institute, only with written consent (site.json → hero).
// Without one, the panel stays the navy brand panel.
const heroImg = site.hero.consent ? resolveImage(site.hero.image) : null;
const heroAlt = site.hero.alt ?? '';
const heroVideo = site.hero.consent && site.hero.video ? site.hero.video : null;
const poster = heroImg ? (await getImage({ src: heroImg, width: Math.min(1280, heroImg.width), format: 'webp' })).src : undefined;
const u = (slug: string) => units.find((x) => x.slug === slug)!;
// The brand idea: one continuous path from age 3 to 18 with two choice points.
// Stops are an interactive explorer: it plays by itself until the visitor picks a stop.
const stops = [
  { age: '۳', label: 'کودکستان', title: 'کودکستان', text: u('kindergarten').short!, meta: u('kindergarten').ages, href: '/units/kindergarten/', cta: 'آشنایی با کودکستان' },
  { age: '۶', label: 'دبستان', title: 'دبستان مهارت‌محور', text: u('primary').short!, meta: u('primary').ages, href: '/units/primary/', cta: 'آشنایی با دبستان' },
  { age: '۱۲', label: 'متوسطه اول', title: 'متوسطه اول پسرانه', text: u('middle-school').short!, meta: u('middle-school').ages, href: '/units/middle-school/', cta: 'آشنایی با متوسطه اول' },
  { age: '۱۵', label: 'انتخاب اول', title: '۱۵ سالگی، پایه نهم', text: 'اولین انتخاب رشته تحصیلی، بر پایه تجربه‌ها و «پرونده انتخاب» خود دانش‌آموز.', meta: 'نقطه انتخاب', href: '/method/', cta: 'متد کودک ماهر', milestone: true },
  { age: '۱۸', label: 'انتخاب نهایی', title: '۱۸ سالگی', text: 'بازنگری و انتخاب نهایی برای دانشگاه یا ورود به کار.', meta: 'نقطه انتخاب', href: '/path/', cta: 'مسیر رشد ۳ تا ۱۸ سال', milestone: true },
];
const words = ['پیش‌بینی', 'تجربه', 'بازبینی'];
---
<section class="relative overflow-hidden border-b border-line" aria-labelledby="hero-title">
  <div class="container-x pt-12 pb-14 sm:pt-16 sm:pb-20">
    <div class="grid gap-10 lg:grid-cols-[1.25fr_1fr] lg:items-stretch lg:gap-14">
      <div class="flex flex-col justify-center">
        <p class="rise kicker" style="--i:0">{site.name}{site.foundingYear && <span class="text-ink-mute">— از <span class="num">{site.foundingYear}</span></span>}</p>
        <h1 id="hero-title" class="rise mt-6 text-[2.5rem] sm:text-[3.25rem] lg:text-[3.75rem]" style="--i:1; line-height:1.3">
          یادگیری برای زندگی،<br /><span class="hero-mark">نه برای امتحان</span>
        </h1>
        <p class="rise lead mt-6 max-w-xl" style="--i:2">از کودکستان تا نوجوانی، کنار فرزندتان هستیم تا خودش را بشناسد، با تجربه واقعی یاد بگیرد و مسیرش را آگاهانه انتخاب کند.</p>
        <div class="rise mt-8 flex flex-wrap gap-3" style="--i:3">
          <a href="/register/" class="btn-primary">پیش‌ثبت‌نام و مشاوره<Icon name="arrow" size={18} /></a>
          <a href="/method/" class="btn-ghost">متد کودک ماهر چیست؟</a>
        </div>
      </div>

      <!-- Brand panel: logo mark + rotating method word; with a consented photo/video behind it when there is one -->
      <div class:list={['relative isolate overflow-hidden rounded-2xl bg-accent p-7 text-white sm:p-9', heroImg ? 'hero-photo' : 'rise']} style="--i:2" data-hero-panel>
        {heroImg && (
          <Picture src={heroImg} alt={heroAlt} formats={['avif', 'webp']} widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 42vw, 100vw"
            loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover" />
        )}
        {heroImg && heroVideo && (
          <video class="absolute inset-0 -z-20 h-full w-full object-cover" muted playsinline loop preload="none" poster={poster} aria-hidden="true" data-hero-video>
            <source src={heroVideo} type="video/mp4" />
          </video>
        )}
        {heroImg
          ? <div class="hero-scrim pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
          : <div class="pointer-events-none absolute -bottom-24 -left-24 -z-10 h-72 w-72 rounded-full border-[28px] border-white/[0.04]" aria-hidden="true"></div>}
        {heroImg && heroVideo && (
          <button type="button" class="absolute top-3 left-3 grid h-11 w-11 place-items-center rounded-full bg-ink/45 text-white backdrop-blur-sm hover:bg-ink/65" data-video-toggle aria-label="پخش ویدیو" aria-pressed="false">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" data-icon-play><path d="M4 2.5v11l9-5.5z" fill="currentColor" /></svg>
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="hidden" data-icon-pause><path d="M4 2.5h3v11H4zM9 2.5h3v11H9z" fill="currentColor" /></svg>
          </button>
        )}
        <div class="flex h-full min-h-[15rem] flex-col justify-between gap-10 sm:min-h-[19rem]">
          <div class="flex items-start justify-between gap-6">
            <p class="max-w-[14rem] font-serif text-lg leading-8 text-gold">{site.slogan2}</p>
            <span class="shrink-0 text-gold" data-logo-draw><Logo variant="mark" class="h-12 w-auto sm:h-14" /></span>
          </div>
          <div>
            <p class="text-sm text-white/70">در هر کلاس و هر کارگاه، یک چرخه تکرار می‌شود:</p>
            <p class="mt-3 font-serif text-[2.25rem] leading-tight sm:text-[2.75rem]" aria-live="off">
              <span class="cycle-word" data-cycle-word>{words[0]}</span>
            </p>
            <ol class="mt-5 flex gap-2" aria-label="چرخه متد">
              {words.map((w, i) => (
                <li class="flex-1">
                  <span class="block h-1 overflow-hidden rounded-full bg-white/15"><span class="cycle-bar block h-full origin-right bg-gold" data-cycle-bar={i}></span></span>
                  <span class="mt-2 block text-xs text-white/70">{w}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- Interactive path explorer -->
    <div class="rise mt-12 rounded-2xl border border-line bg-surface p-5 sm:p-8" style="--i:4" data-explorer>
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="font-sans text-base font-semibold">یک مسیر پیوسته، از ۳ تا ۱۸ سالگی</h2>
        <p class="text-sm text-ink-mute">روی هر سن بزنید</p>
      </div>
      <div class="relative mt-8">
        <div class="absolute inset-x-[10%] top-[13px] h-0.5 bg-line" aria-hidden="true">
          <div class="path-draw h-full origin-right bg-accent"></div>
          <div class="absolute inset-y-0 right-0 bg-gold transition-[width] duration-700 ease-[cubic-bezier(.23,1,.32,1)]" style="width:0%" data-explorer-fill></div>
        </div>
        <div class="relative grid grid-cols-5" role="tablist" aria-label="مراحل مسیر">
          {stops.map((s, i) => (
            <button type="button" role="tab" id={`stop-${i}`} aria-controls="stop-panel" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
              class="path-stop group flex flex-col items-center text-center" style={`--i:${i}`} data-stop={i}>
              <span class:list={['stop-dot grid h-7 w-7 place-items-center rounded-full border-2 border-accent bg-surface transition-[transform,background-color] duration-300', s.milestone && 'stop-milestone']}>
                <span class="h-2 w-2 rounded-full bg-accent transition-colors duration-300"></span>
              </span>
              <span class="num mt-3 text-[1.5rem] leading-none transition-colors duration-300 sm:text-[2rem]">{s.age}</span>
              <span class="mt-2 text-xs text-ink-soft sm:text-sm">{s.label}</span>
            </button>
          ))}
        </div>
      </div>
      <div id="stop-panel" role="tabpanel" aria-labelledby="stop-0" class="mt-7 grid gap-4 border-t border-line pt-6 sm:grid-cols-[1fr_auto] sm:items-end" aria-live="polite">
        {stops.map((s, i) => (
          <div class:list={['stop-content', i !== 0 && 'hidden']} data-stop-content={i}>
            <p class="text-sm text-saffron">{s.meta}</p>
            <h3 class="mt-1 text-2xl">{s.title}</h3>
            <p class="mt-2 max-w-2xl text-ink-soft">{s.text}</p>
            <a href={s.href} class="link mt-3 inline-flex items-center gap-1 text-sm">{s.cta}<Icon name="arrow" size={15} /></a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Hero video: muted and looping, starts only when there is motion permission and no data saver,
  // and can always be paused (WCAG 2.2.2). Under reduced motion the poster photo stays.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
  if (video && toggle) {
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    const setState = (playing: boolean) => {
      toggle.setAttribute('aria-pressed', String(playing));
      toggle.setAttribute('aria-label', playing ? 'توقف ویدیو' : 'پخش ویدیو');
      toggle.querySelector('[data-icon-play]')!.classList.toggle('hidden', playing);
      toggle.querySelector('[data-icon-pause]')!.classList.toggle('hidden', !playing);
    };
    const play = () => { video.preload = 'auto'; video.play().then(() => setState(true)).catch(() => setState(false)); };
    toggle.addEventListener('click', () => (video.paused ? play() : (video.pause(), setState(false))));
    if (!reduce && !saveData) play();
  }

  // Rotating method word in the brand panel (3s per word, bars fill like stories)
  const word = document.querySelector<HTMLElement>('[data-cycle-word]');
  const bars = [...document.querySelectorAll<HTMLElement>('[data-cycle-bar]')];
  const words = ['پیش‌بینی', 'تجربه', 'بازبینی'];
  let w = 0;
  const showWord = (i: number) => {
    bars.forEach((b, k) => { b.classList.toggle('is-done', k < i); b.classList.toggle('is-active', k === i); });
    if (!word) return;
    word.classList.remove('is-in'); void word.offsetWidth;
    word.textContent = words[i]; word.classList.add('is-in');
  };
  showWord(0);
  if (!reduce) setInterval(() => { w = (w + 1) % 3; showWord(w); }, 3000);
  else bars.forEach((b) => b.classList.add('is-done'));

  // Path explorer: tabs with arrow keys, autoplay until the visitor interacts
  const root = document.querySelector<HTMLElement>('[data-explorer]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-stop]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-stop-content]')];
    const fill = root.querySelector<HTMLElement>('[data-explorer-fill]')!;
    const panel = root.querySelector<HTMLElement>('#stop-panel')!;
    let current = 0; let timer: number | undefined; let interacted = false;
    const select = (i: number, focus = false) => {
      current = i;
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1;
        t.classList.toggle('is-active', k === i); t.classList.toggle('is-passed', k < i);
      });
      panels.forEach((p, k) => p.classList.toggle('hidden', k !== i));
      panel.setAttribute('aria-labelledby', tabs[i].id);
      fill.style.width = `${(i / (tabs.length - 1)) * 100}%`;
      const shown = panels[i];
      shown.classList.remove('is-in'); void shown.offsetWidth; shown.classList.add('is-in');
      if (focus) tabs[i].focus();
    };
    const stop = () => { interacted = true; if (timer) { clearInterval(timer); timer = undefined; } };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => { stop(); select(i); });
      t.addEventListener('keydown', (e) => {
        // RTL: ArrowLeft moves forward
        const d = e.key === 'ArrowLeft' ? 1 : e.key === 'ArrowRight' ? -1 : 0;
        if (d) { e.preventDefault(); stop(); select((i + d + tabs.length) % tabs.length, true); }
      });
    });
    root.addEventListener('pointerenter', stop, { once: true });
    select(0);
    if (!reduce) {
      // start autoplay only once the explorer is on screen
      const io = new IntersectionObserver(([en]) => {
        if (en.isIntersecting && !timer && !interacted) { timer = window.setInterval(() => select((current + 1) % tabs.length), 3500); io.disconnect(); }
      }, { threshold: 0.5 });
      io.observe(root);
    }
  }
</script>
