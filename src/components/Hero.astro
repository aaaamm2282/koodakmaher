---
import Icon from './Icon.astro';
import { site } from '../data/site';
// The path is the brand idea: one continuous line from age 3 to 18, with two choice points.
const stops = [
  { age: '۳', label: 'کودکستان', href: '/units/kindergarten/' },
  { age: '۶', label: 'دبستان', href: '/units/primary/' },
  { age: '۱۲', label: 'متوسطه اول', href: '/units/middle-school/' },
  { age: '۱۵', label: 'انتخاب اول', milestone: true, href: '/path/' },
  { age: '۱۸', label: 'انتخاب نهایی', milestone: true, href: '/path/' },
];
---
<section class="border-b border-line" aria-labelledby="hero-title">
  <div class="container-x pt-14 pb-14 sm:pt-20 sm:pb-20">
    <div class="grid gap-10 lg:grid-cols-[1.35fr_1fr] lg:items-end">
      <div>
        <p class="rise kicker" style="--i:0">{site.name}{site.foundingYear && <span class="text-ink-mute">· از <span class="num">{site.foundingYear}</span></span>}</p>
        <h1 id="hero-title" class="rise mt-6 text-[2.5rem] sm:text-[3.25rem] lg:text-[4rem]" style="--i:1; line-height:1.3">
          یادگیری برای زندگی،<br /><span class="text-accent">نه برای امتحان</span>
        </h1>
      </div>
      <div class="lg:pb-3">
        <p class="rise lead" style="--i:2">از کودکستان تا نوجوانی، کنار فرزندتان هستیم تا خودش را بشناسد، با تجربه واقعی یاد بگیرد و مسیرش را آگاهانه انتخاب کند.</p>
        <div class="rise mt-7 flex flex-wrap gap-3" style="--i:3">
          <a href="/register/" class="btn-primary">پیش‌ثبت‌نام و مشاوره<Icon name="arrow" size={18} /></a>
          <a href="/method/" class="btn-ghost">متد کودک ماهر چیست؟</a>
        </div>
      </div>
    </div>

    <div class="rise mt-14 rounded-xl border border-line bg-surface px-4 pt-6 pb-5 sm:px-8 sm:pt-8 sm:pb-7" style="--i:4">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <p class="text-sm font-medium">یک مسیر پیوسته، از ۳ تا ۱۸ سالگی</p>
        <a href="/path/" class="link text-sm">مسیر رشد را ببینید</a>
      </div>
      <div class="relative mt-8">
        <div class="absolute inset-x-[10%] top-[11px] h-0.5 bg-line" aria-hidden="true">
          <div class="path-draw h-full origin-right bg-accent"></div>
        </div>
        <ol class="relative grid grid-cols-5">
          {stops.map((s, i) => (
            <li class="path-stop text-center" style={`--i:${i}`}>
              <a href={s.href} class="group inline-flex flex-col items-center">
                <span class:list={['grid h-6 w-6 place-items-center rounded-full border-2 border-accent', s.milestone ? 'bg-accent' : 'bg-surface']}>
                  {s.milestone && <span class="h-1.5 w-1.5 rounded-full bg-white"></span>}
                </span>
                <span class="num mt-3 text-[1.5rem] leading-none sm:text-[2rem]">{s.age}</span>
                <span class="mt-2 text-xs text-ink-soft group-hover:text-ink sm:text-sm">{s.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
