---
import Icon from './Icon.astro';
import { site } from '../data/site';
// Set PUBLIC_FORM_ENDPOINT (e.g. a Formspree/Getform URL or your own API) to receive submissions.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const field = 'mt-1.5 block w-full min-h-12 rounded-2xl border-2 border-transparent bg-white px-4 text-base text-ink shadow-sm outline-none transition focus:border-ink placeholder:text-ink/40';
---
<form id="register-form" class="rounded-[2rem] bg-cream p-6 shadow-[0_8px_0_#1f1a3d] ring-4 ring-ink sm:p-8" action={endpoint || undefined} method="post" data-endpoint={endpoint} data-sms={site.mobile} novalidate>
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block font-bold">نام والد
      <input class={field} name="parent" autocomplete="name" required placeholder="مثلاً: مریم احمدی" />
    </label>
    <label class="block font-bold">شماره‌ی موبایل
      <input class={field} name="phone" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" required pattern="^(\+98|0)?9\d{9}$" placeholder="09xx xxx xxxx" />
    </label>
    <label class="block font-bold">نام کودک
      <input class={field} name="child" required placeholder="نام کوچک کودک" />
    </label>
    <label class="block font-bold">سن کودک
      <select class={field} name="age" required>
        <option value="">انتخاب کنید</option>
        <option>۳ سال</option><option>۴ سال</option><option>۵ سال</option><option>۶ سال</option>
      </select>
    </label>
    <label class="block font-bold sm:col-span-2">توضیحات (اختیاری)
      <textarea class={field + ' min-h-24 py-3'} name="note" rows="3" placeholder="سؤال یا نکته‌ای که دوست دارید بدانیم"></textarea>
    </label>
  </div>
  <p id="form-error" class="mt-3 hidden text-sm font-bold text-coral" role="alert"></p>
  <button type="submit" class="btn-primary shimmer mt-5 w-full text-lg">
    ارسال درخواست
    <Icon name="send" size={20} />
  </button>
  <div id="form-success" class="hidden text-center" role="status" aria-live="polite">
    <span class="mx-auto grid h-20 w-20 place-items-center rounded-full bg-mint text-white"><Icon name="check" size={40} /></span>
    <p class="mt-4 text-2xl font-black">درخواست شما ثبت شد!</p>
    <p class="mt-2 text-ink-soft">به‌زودی برای هماهنگی بازدید با شما تماس می‌گیریم.</p>
  </div>
</form>

<script>
  import { animate } from 'motion';
  const form = document.getElementById('register-form') as HTMLFormElement;
  const err = document.getElementById('form-error')!;
  const ok = document.getElementById('form-success')!;
  const toEn = (s: string) => s.replace(/[۰-۹]/g, (d) => String('۰۱۲۳۴۵۶۷۸۹'.indexOf(d))).replace(/\s|-/g, '');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const phone = form.elements.namedItem('phone') as HTMLInputElement;
    phone.value = toEn(phone.value);
    if (!form.checkValidity()) {
      const bad = form.querySelector<HTMLElement>(':invalid');
      err.textContent = phone.validity.patternMismatch ? 'شماره‌ی موبایل معتبر نیست (مثلاً ۰۹۱۲۳۴۵۶۷۸۹).' : 'لطفاً فیلدهای ضروری را کامل کنید.';
      err.classList.remove('hidden');
      bad?.focus();
      animate(form, { x: [0, -10, 10, -6, 6, 0] }, { duration: 0.4 });
      return;
    }
    err.classList.add('hidden');
    const endpoint = form.dataset.endpoint;
    if (endpoint) {
      try {
        const res = await fetch(endpoint, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error();
      } catch {
        err.textContent = 'ارسال انجام نشد. لطفاً دوباره تلاش کنید یا تماس بگیرید.';
        err.classList.remove('hidden');
        return;
      }
    } else {
      // No backend configured yet: hand the request to the phone's SMS app so it still reaches the school.
      const d = new FormData(form);
      const body = `درخواست ثبت‌نام کودک ماهر\nوالد: ${d.get('parent')}\nموبایل: ${d.get('phone')}\nکودک: ${d.get('child')} (${d.get('age')})\n${d.get('note') || ''}`;
      window.location.href = `sms:${form.dataset.sms}?&body=${encodeURIComponent(body)}`;
    }
    [...form.children].forEach((c) => c !== ok && c.classList.add('hidden'));
    ok.classList.remove('hidden');
    animate(ok, { opacity: [0, 1], scale: [0.8, 1] }, { type: 'spring', stiffness: 300, damping: 18 });
  });
</script>
