---
// Units as an index list (name and ages · what it is · arrow), not a grid of coloured tiles.
// The order already runs from the youngest to the oldest, so the rows carry no numbers.
import Icon from './Icon.astro';
import Pending from './Pending.astro';
import { units } from '../data/site';
---
<ul class="border-t border-line" data-stagger>
  {units.map((u) => (
    <li class="border-b border-line">
      <a href={`/units/${u.slug}/`} class="row-wipe group grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-2 px-1 py-6 active:bg-sand sm:grid-cols-[15rem_1fr_auto] sm:items-baseline sm:gap-x-8 sm:px-4 sm:py-7">
        <span class="col-start-1 row-start-1">
          <span class="flex flex-wrap items-center gap-x-2 gap-y-1 font-serif text-xl font-semibold sm:text-2xl">{u.name}{u.soon && <span class="chip font-sans">به‌زودی</span>}</span>
          {u.ages && <span class="mt-1 block text-sm text-ink-mute">{u.ages}</span>}
        </span>
        <span class="col-span-2 row-start-2 text-ink-soft sm:col-span-1 sm:col-start-2 sm:row-start-1">{u.short ?? <Pending inline label={u.shortPending ?? undefined} />}</span>
        <span class="row-arrow col-start-2 row-start-1 flex items-center gap-1 text-sm font-medium text-accent sm:col-start-3">
          <span class="hidden sm:inline">جزئیات</span><Icon name="arrow" size={18} class="transition-transform duration-200 group-hover:-translate-x-1.5" />
        </span>
      </a>
    </li>
  ))}
</ul>
