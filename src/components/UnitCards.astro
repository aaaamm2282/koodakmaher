---
// Units as an index list (name · age · line · arrow), not a grid of coloured tiles.
import Icon from './Icon.astro';
import Pending from './Pending.astro';
import { units } from '../data/site';
---
<ul class="border-t border-line" data-stagger>
  {units.map((u, i) => (
    <li class="border-b border-line">
      <a href={`/units/${u.slug}/`} class="row-wipe group grid gap-x-8 gap-y-2 px-1 py-6 sm:grid-cols-[3rem_14rem_1fr_auto] sm:items-baseline sm:px-4 sm:py-7">
        <span class="num hidden text-lg text-ink-mute sm:block">{(i + 1).toLocaleString('fa-IR', { minimumIntegerDigits: 2 })}</span>
        <span>
          <span class="flex items-center gap-2 font-serif text-xl font-semibold sm:text-[1.375rem]">{u.name}{u.soon && <span class="rounded-md bg-saffron-soft px-1.5 py-px font-sans text-xs font-medium text-saffron">به‌زودی</span>}</span>
          {u.ages && <span class="mt-1 block text-sm text-ink-mute">{u.ages}</span>}
        </span>
        <span class="text-ink-soft">{u.short ?? <Pending inline label={u.shortPending} />}</span>
        <span class="row-arrow hidden items-center gap-1 text-sm font-medium text-accent sm:flex">
          جزئیات<Icon name="arrow" size={16} class="transition-transform duration-200 group-hover:-translate-x-1.5" />
        </span>
      </a>
    </li>
  ))}
</ul>
