---
// Units as sheets of coloured paper, each with its drawing. The four stages of the path stand in one row, in the
// order a child meets them (high school, still to come, is a dashed outline); the two schools beside the path, the
// language school and the vocational school, sit under them as wider sheets. Each sheet is one link.
import Art from './Art.astro';
import Icon from './Icon.astro';
import Pending from './Pending.astro';
import { units } from '../data/site';
import { unitTone, unitArt } from '../data/tones';
interface Props { /** h3 under a section heading (home); h2 straight under the page heading (/units/) */ level?: 'h2' | 'h3' }
const { level = 'h3' } = Astro.props;
const Name = level;
const path = units.filter((u) => ['kindergarten', 'primary', 'middle-school', 'high-school'].includes(u.slug));
const beside = units.filter((u) => !path.includes(u));
---
<div class="grid gap-4 sm:gap-5">
  {[path, beside].map((row, r) => (
    <ul class:list={['grid gap-4 sm:gap-5', r === 0 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-2']} role="list">
      {row.map((u) => (
        <li class:list={['tile p-6', r === 0 ? 'tile-tall sm:min-h-[22rem] sm:p-7' : 'tile-wide sm:min-h-[15rem] sm:p-8']} data-tone={unitTone[u.slug]}>
          <span class="tile-art" aria-hidden="true"><Art name={unitArt(u.slug)} /></span>
          <Name class="tile-name flex flex-wrap items-center gap-x-2.5 gap-y-1 text-2xl" style="line-height:1.4">
            <a href={`/units/${u.slug}/`} class="after:absolute after:inset-0">{u.name}</a>
            {u.soon && <span class="chip font-sans">به‌زودی</span>}
          </Name>
          {u.ages && <p class="tile-ages">{u.ages}</p>}
          <p class="tile-text">{u.short ?? <Pending inline label={u.shortPending ?? undefined} class="!text-inherit" />}</p>
          {!u.soon && <span class="tile-go" aria-hidden="true"><Icon name="arrow" size={20} /></span>}
        </li>
      ))}
    </ul>
  ))}
</div>
