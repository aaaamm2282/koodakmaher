---
// The growth file (پرونده رشد) on /parents/, drawn as a navy folder standing open in perspective with three sheets
// showing (after "3D Folder" on 21st.dev, idea only; docs/21st-elements.md); a mouse over it opens it further.
// The sheets are the three things the paragraph next to it says the file keeps.
// Decorative: the paragraph carries the same words, so screen readers skip it.
import Logo from './Logo.astro';
const sheets = ['آرزوها و علاقه‌ها', 'حدس‌ها و نتیجه‌ها', 'تجربه‌ها'];
const tilt = [-1.2, 0.8, -0.5];
---
<div class="gfile" aria-hidden="true">
  <div class="gfile-back"><span class="gfile-tab">پرونده رشد</span></div>
  {sheets.map((s, k) => (
    <div class="gfile-sheet" style={`--k:${k};--top:${15 + k * 9.5}%;rotate:${tilt[k]}deg`}><span>{s}</span></div>
  ))}
  <div class="gfile-front"><Logo variant="mark" class="gfile-mark" /></div>
</div>
