---
// Home "method" block: a circle diagram whose gold marker walks predict → experience → review,
// synced with the step list. Plays while in view; stops when the visitor picks a step.
import { cycle } from '../data/site';
const nodes = [[160, 40], [264, 220], [56, 220]];
---
<div class="grid items-center gap-10 lg:grid-cols-[1fr_1.15fr] lg:gap-16" data-orbit>
  <div class="mx-auto w-full max-w-[17rem] sm:max-w-[22rem]" aria-hidden="true">
    <svg viewBox="0 0 320 320" class="w-full overflow-visible">
      <circle cx="160" cy="160" r="120" fill="none" stroke="rgb(23 32 28 / .12)" stroke-width="1.5" />
      <circle cx="160" cy="160" r="120" fill="none" stroke="#01237a" stroke-width="2" stroke-dasharray="4 10" stroke-linecap="round" class="orbit-dash" />
      <g class="orbit-marker" data-orbit-marker style="transform-origin:160px 160px">
        <circle cx="160" cy="40" r="30" fill="#d9b25a" opacity=".25" />
      </g>
      {nodes.map(([x, y], i) => (
        <g class="orbit-node" data-orbit-node={i}>
          <circle cx={x} cy={y} r="22" fill="#fff" stroke="#01237a" stroke-width="2" />
          <text x={x} y={y + 7} text-anchor="middle" font-size="20" font-family="var(--font-serif)" fill="#01237a">{(i + 1).toLocaleString('fa-IR')}</text>
        </g>
      ))}
      <text x="160" y="152" text-anchor="middle" font-size="13" fill="#6b736f" font-family="var(--font-sans)">چرخه متد</text>
      <text x="160" y="186" text-anchor="middle" font-size="30" fill="#17201c" font-family="var(--font-serif)" data-orbit-label>{cycle[0].title}</text>
    </svg>
  </div>
  <ol class="border-t border-line" role="list">
    {cycle.map((c, i) => (
      <li class="border-b border-line">
        <button type="button" class:list={['orbit-step flex w-full items-start gap-5 py-6 text-right', i === 0 && 'is-active']} data-orbit-step={i} aria-pressed={i === 0 ? 'true' : 'false'}>
          <span class="num text-[2rem] leading-none text-ink-mute transition-colors duration-300">{(i + 1).toLocaleString('fa-IR')}</span>
          <span class="flex-1">
            <span class="block font-serif text-2xl font-semibold" data-orbit-title>{c.title}</span>
            <span class="orbit-text block text-ink-soft">{c.text}</span>
          </span>
        </button>
      </li>
    ))}
  </ol>
</div>

<script>
  // Titles come from the rendered list, so the page data is not shipped to the browser.
  document.querySelectorAll<HTMLElement>('[data-orbit]').forEach((root) => {
    const marker = root.querySelector<SVGGElement>('[data-orbit-marker]')!;
    const label = root.querySelector<SVGTextElement>('[data-orbit-label]')!;
    const steps = [...root.querySelectorAll<HTMLButtonElement>('[data-orbit-step]')];
    const nodes = [...root.querySelectorAll<SVGGElement>('[data-orbit-node]')];
    const titles = steps.map((s) => s.querySelector('[data-orbit-title]')?.textContent ?? '');
    let current = 0, turns = 0, timer: number | undefined, interacted = false;
    const set = (i: number) => {
      const diff = (i - current + 3) % 3;
      turns += diff; current = i;
      marker.style.transform = `rotate(${turns * 120}deg)`;
      label.textContent = titles[i];
      steps.forEach((s, k) => { s.classList.toggle('is-active', k === i); s.setAttribute('aria-pressed', String(k === i)); });
      nodes.forEach((n, k) => n.classList.toggle('is-active', k === i));
    };
    set(0);
    const stop = () => { interacted = true; clearInterval(timer); };
    steps.forEach((s, i) => s.addEventListener('click', () => { stop(); set(i); }));
    // A keyboard or screen-reader user on the steps: the active step must not move under them
    root.addEventListener('focusin', stop, { once: true });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    new IntersectionObserver(([e]) => {
      clearInterval(timer);
      if (e.isIntersecting && !interacted) timer = window.setInterval(() => set((current + 1) % 3), 3200);
    }, { threshold: 0.4 }).observe(root);
  });
</script>
