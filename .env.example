# تنظیمات ساخت سایت. این فایل را با نام .env کنار همین فایل کپی کنید و فقط خانه‌هایی را که لازم دارید پر کنید.
# روی سرویس‌هایی مثل Netlify یا Cloudflare Pages همین نام‌ها را در بخش Environment variables همان سرویس بگذارید.
# رمز یا توکن اینجا نمی‌آید: این مقدارها در کد صفحه‌ها دیده می‌شوند. توکن ربات و نشانی ذخیره‌ی فرم‌ها
# فقط در form-config.php روی هاست، بیرون از پوشه‌ی سایت، می‌ماند. راهنما: docs/forms-setup.md

# نشانی نهایی سایت، بدون / در آخر (برای canonical، نقشه‌ی سایت، لینک‌های پیامک و QR)
SITE_URL=https://mahermana.com

# مقصد فرم‌ها. خالی = فرم‌ها فقط بررسی می‌شوند و می‌گویند «ارسال فرم‌ها هنوز راه‌اندازی نشده».
# گیرنده‌ی PHP همین مخزن روی همان هاست: /api/form.php (ساخت، آن را خودش در dist/api/form.php می‌گذارد)
PUBLIC_FORM_ENDPOINT=

# آمار بازدید، اختیاری. خالی = هیچ کد آماری در سایت بارگذاری نمی‌شود.
# شناسه‌ی اندازه‌گیری Google Analytics 4، مثل G-ABC123XYZ
PUBLIC_GA4_ID=
# یا Umami (روی سرور خودتان یا Umami Cloud): نشانی اسکریپت (https://…/script.js) و شناسه‌ی سایت در Umami
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_ID=

# فقط برای نسخه‌ی بازبینی، نه سایت اصلی (همه‌ی صفحه‌ها noindex می‌شوند):
# SHOW_DRAFTS=1             پیش‌نویس مقاله‌ها هم ساخته می‌شوند
# (PREVIEW_PHOTOS=1 را خودِ npm run preview:photos می‌گذارد)
# فقط روی هاستی که هیچ ریدایرکتی نمی‌پذیرد (docs/migration.md):
# STATIC_REDIRECT_PAGES=1
